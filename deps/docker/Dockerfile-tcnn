# DOCKER_BUILDKIT=1 docker image build --progress=plain --tag tcnn:pt270 [--platform linux/arm64 --build-arg ARCH=aarch64] --build-arg GITHUB_TOKEN=$GITHUB_TOKEN --build-arg GITLAB_TOKEN=$GITLAB_TOKEN -f Dockerfile-tcnn .
# 
# make sure to use 20.04 as the minimal compatible glibc version
FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu20.04
ENV DEBIAN_FRONTEND=noninteractive 

RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y wget git ninja-build && \
    rm -rf /var/lib/apt/lists/*

ENV PATH="/root/miniconda3/bin:${PATH}"

ARG ARCH="x86_64"
RUN wget \
    https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-${ARCH}.sh \
    && mkdir /root/.conda \
    && bash Miniconda3-latest-Linux-${ARCH}.sh -b \
    && rm -f Miniconda3-latest-Linux-${ARCH}.sh

ENV TORCH_VERSION="2.7.0"
ENV CUDA_VERSION="cu128"
ARG EXTRA_VERSION="sm75to120"
ENV PYTHON_VERSION="3.11"

RUN conda --version
RUN conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main --channel https://repo.anaconda.com/pkgs/r
RUN conda init bash
RUN conda create -n tcnn-env python=$PYTHON_VERSION -y

SHELL ["conda", "run", "-n", "tcnn-env", "/bin/bash", "-c"]

RUN conda install -y cmake
RUN pip install torch==$TORCH_VERSION+$CUDA_VERSION --extra-index-url https://download.pytorch.org/whl/$CUDA_VERSION

ARG GITLAB_TOKEN
RUN echo 'machine gitlab-master.nvidia.com \n\
  login oauth2 \n\
  password '$GITLAB_TOKEN > ~/.netrc

ARG CACHEBUST=1 # bump to re-download repo
RUN git clone --recursive https://oauth2:$GITLAB_TOKEN@gitlab-master.nvidia.com/nrs/nre_external/tiny-cuda-nn.git
WORKDIR tiny-cuda-nn
RUN git checkout c2de4fa9e4e87794371d9f0129da341c4f6bbd98
RUN sed -i -e 's/url = ssh:\/\/git@gitlab-master.nvidia.com:12051\/tmueller\/tin2.git/url = https:\/\/gitlab-master.nvidia.com\/tmueller\/tin2.git/g' .gitmodules
RUN sed -i -e 's/ALL_COMPUTE_CAPABILITIES = \[20, 21, 30, 35, 37, 50, 52, 53, 60, 61, 62, 70, 72, 75, 80, 86, 87, 89, 90\]/ALL_COMPUTE_CAPABILITIES = \[20, 21, 30, 35, 37, 50, 52, 53, 60, 61, 62, 70, 72, 75, 80, 86, 87, 89, 90, 100, 120\]/g' ./bindings/torch/tinycudann/modules.py
RUN sed -i -e 's/set(LATEST_SUPPORTED_CUDA_ARCHITECTURE 90)/set(LATEST_SUPPORTED_CUDA_ARCHITECTURE 120)/g' ./CMakeLists.txt
RUN git submodule update --init --recursive

# Build JIT-enabled variant for 75;80;86;89;90;100;120 (add +git{GIT_HASH}pt2.7.0cu128sm75to120 version tag)
RUN GIT_HASH=$(git rev-parse --short HEAD) \
    && sed -i -e "s/version=VERSION,/version=VERSION\+\"\+git${GIT_HASH}pt${TORCH_VERSION}${CUDA_VERSION}${EXTRA_VERSION}\",/g" bindings/torch/setup.py
RUN sed -i -e 's/return 90/return 120/g' ./bindings/torch/setup.py
RUN cmake -B build -DTCNN_CUDA_ARCHITECTURES="75;80;86;89;90;100;120" .
RUN cmake --build build --config RelWithDebInfo -j --verbose
WORKDIR bindings/torch
RUN TCNN_CUDA_ARCHITECTURES="75;80;86;89;90;100;120" FORCE_CUDA=1 pip wheel . --verbose
RUN mv tinycudann*.whl ../..

WORKDIR ../..

# ###############################################################################################################
# TWINE UPLOADS
RUN pip install twine
ENV TWINE_USERNAME=deploy_token_username
# Uncomment the next line(s) to upload wheels [verify wheels before uploading!]:
# RUN TWINE_PASSWORD=$GITLAB_TOKEN twine upload --repository-url https://gitlab-master.nvidia.com/api/v4/projects/85874/packages/pypi tinycudann*.whl --verbose --skip-existing --non-interactive

# Base image for `//:run` / `//apps:nre_tools` target images

# Prerequisites:
# Install docker utils: https://docs.docker.com/engine/install/ubuntu/

# Latest version is: v8, please increment it
# BUILD: DOCKER_BUILDKIT=1 docker image build -t gitlab-master.nvidia.com:5005/nrs/nre:run-v8 -f deps/docker/Dockerfile-run.build .
# PUSH:  docker push gitlab-master.nvidia.com:5005/nrs/nre:run-v8

# Ubuntu 24.04 [use an up-to-date OS version to prevent runtime glibc-issues of host-compiled binaries]
# CUDA 12.8.0 [has to be at least cuda12.8 for current run target]
# devel image is needed for slangc
FROM nvcr.io/nvidia/cuda:12.8.0-cudnn-devel-ubuntu24.04

LABEL maintainer="Janick Martinez Esturo <janickm@nvidia.com>"

# Needed for string substitution
ENV DEBIAN_FRONTEND=noninteractive

RUN \
    # Common base installation
    apt-get update -qq --fix-missing || true && \
    apt-get -y install --no-install-recommends \
        # run dependencies
        python3 python3-pip libgomp1 libglib2.0-0 libgl1 libopenblas-dev \
        # mask annotator dependencies
        libqt6gui6 libqt6widgets6 libqt6core6 libdbus-1-3 libfontconfig1 libxkbcommon0 libxkbcommon-x11-0 libxcb-cursor0 \
        # asset harvester dependencies
        gcc-11 g++-11 \
        && \
    rm -rf /var/lib/apt/lists/*

RUN \
   # Add python -> python3 symlink (required for bazel-build image entrypoints)
   ln -s /usr/bin/python3 /usr/bin/python && \
   # Remove default ubuntu user to avoid giving its UID/GID a special status when starting the container as non-root user
   userdel -r ubuntu

# Set required driver capabilities ('compute' for cuda, 'graphics' for optix, 'utility' for nvidia-smi)
ENV NVIDIA_DRIVER_CAPABILITIES=graphics,compute,utility

# Make all devices visible by default
ENV NVIDIA_VISIBLE_DEVICES=all

RUN \
    # Upgrade gpgv to 2.4.4-2ubuntu17.4 to address security vulnerability CVE-2025-68973,
    # then remove gnupg and its dependencies (keeping gpgv which is required by apt)
    apt-get update -qq && \
    apt-get install -y --no-install-recommends gpgv=2.4.4-2ubuntu17.4 && \
    apt-get -y purge --auto-remove gnupg && \
    rm -rf /var/lib/apt/lists/*

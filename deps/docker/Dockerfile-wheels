# DOCKER_BUILDKIT=1 docker image build --tag wheels:pt270 [--platform linux/arm64 --build-arg ARCH=aarch64] --build-arg GITLAB_TOKEN=$GITLAB_TOKEN --build-arg TWINE_PASSWORD=$TWINE_PASSWORD/$GITLAB_TOKEN -f Dockerfile-wheels .
FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu20.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y wget git zip unzip ninja-build libegl1-mesa-dev libtbb-dev libatlas-base-dev libssl-dev gfortran pkg-config autoconf ffmpeg libavcodec-dev libavfilter-dev libavformat-dev libavutil-dev && \
    rm -rf /var/lib/apt/lists/*
ENV PATH="/root/miniconda3/bin:${PATH}"
ARG ARCH="x86_64"
RUN wget \
    https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-${ARCH}.sh \
    && mkdir /root/.conda \
    && bash Miniconda3-latest-Linux-${ARCH}.sh -b \
    && rm -f Miniconda3-latest-Linux-${ARCH}.sh
ARG TORCH_VERSION="2.7.0"
ENV CUDA_VERSION="cu128"
ARG EXTRA_VERSION="sm80to120"
ENV TORCH_CUDA_ARCH_LIST="8.0;8.6;8.9;9.0;10.0;12.0;12.0+PTX"
RUN conda --version
RUN conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main --channel https://repo.anaconda.com/pkgs/r
RUN conda init bash
RUN conda create -n nre_wheel_buildenv python=3.11 -y
SHELL ["conda", "run", "-n", "nre_wheel_buildenv", "/bin/bash", "-c"]
RUN conda install -y \
    # static libpython3.X.a python library required for usd-core
    libpython-static
RUN pip install \
    numpy \
    # Note: twine 6.2.0 removed --skip-existing
    twine\<6.2.0 \
    torch==$TORCH_VERSION+$CUDA_VERSION \
    wheel \
    auditwheel \
    patchelf \
    cmake \
    --extra-index-url https://download.pytorch.org/whl/$CUDA_VERSION
ARG GITLAB_TOKEN
ARG TWINE_PASSWORD
ARG CACHEBUST=0
ENV CUDA_HOME=/usr/local/cuda
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV TWINE_USERNAME=deploy_token_username
###############################################################################################################
# usd-core
ARG USD_VERSION="26.3"
RUN git clone https://github.com/PixarAnimationStudios/OpenUSD.git
WORKDIR OpenUSD
RUN git checkout v26.03
RUN python build_scripts/build_usd.py \
   --build-args USD,"-DPXR_PY_UNDEFINED_DYNAMIC_LOOKUP=ON -DPXR_BUILD_USD_TOOLS=OFF -DPXR_INSTALL_LOCATION=../pxr/pluginfo" \
   --no-materialx \
   --no-imaging \
   --no-examples \
   --no-tutorials \
   --build /OpenUSD-app/gen/build \
   --src /OpenUSD-app/gen/src \
   /OpenUSD-app/inst \
   -v
ARG PYTHON_TAG="cp311"
RUN mkdir ./packaging && \
    cp -R /OpenUSD-app/inst ./packaging  && \
    cp build_scripts/pypi/package_files/* ./packaging  && \
    cp LICENSE.txt ./packaging
WORKDIR packaging
RUN python setup.py bdist_wheel --python-tag ${PYTHON_TAG}  && \
    PYTHONPATH=/OpenUSD-app/packaging/pypi/lib/python LD_LIBRARY_PATH=/OpenUSD/packaging/pypi/lib:$LD_LIBRARY_PATH auditwheel repair dist/*.whl
WORKDIR wheelhouse
RUN mv usd_core-${USD_VERSION}-${PYTHON_TAG}-none-manylinux_2_31_${ARCH}.whl usd_core-${USD_VERSION}-${PYTHON_TAG}-none-manylinux_2_31_${ARCH}_preupdate.whl
WORKDIR /OpenUSD
RUN python build_scripts/pypi/updatePluginfos.py \
  "packaging/wheelhouse/usd_core-${USD_VERSION}-${PYTHON_TAG}-none-manylinux_2_31_${ARCH}_preupdate.whl" \
  "packaging/wheelhouse/usd_core-${USD_VERSION}-${PYTHON_TAG}-none-manylinux_2_31_${ARCH}.whl"  && \
  rm packaging/wheelhouse/*preupdate.whl*
###############################################################################################################
# decord
RUN git clone --recursive https://oauth2:$GITLAB_TOKEN@gitlab-master.nvidia.com/nrs/nre_external/decord.git
WORKDIR decord
# v0.6.0, patched for aarch64 compat
RUN git checkout 3bb314828c626d7c33e4f84a85772593fce7ea40 && git submodule update --init --recursive
RUN if [ "$ARCH" = "aarch64" ]; then \
    cmake -S . -B build -DUSE_CUDA=OFF -DFFMPEG_DIR=/usr/lib/aarch64-linux-gnu -DCMAKE_BUILD_TYPE=Release; \
    else \
    cmake -S . -B build -DUSE_CUDA=OFF -DCMAKE_BUILD_TYPE=Release; \
    fi && \
    cmake --build build && \
    cd python && pip wheel . --verbose
WORKDIR /
###############################################################################################################
# TransformerEngine (flash-attn as a byproduct)
RUN git clone https://oauth2:$GITLAB_TOKEN@gitlab-master.nvidia.com/nrs/nre_external/TransformerEngine.git
WORKDIR TransformerEngine
RUN git checkout cafd8e50200a5cd3eb269b7cc2a8d5ecc091374f
RUN git submodule update --init --recursive
RUN MAX_JOBS=32 NVTE_FRAMEWORK=pytorch pip wheel . --no-build-isolation -v -w dist/
WORKDIR /
###############################################################################################################
# APEX
RUN git clone https://github.com/NVIDIA/apex.git
WORKDIR apex
RUN git checkout 312acb44f9fe05cab8c67bba6daa0e64d3737863
RUN GIT_HASH=$(git rev-parse --short HEAD) \
    && VERSION=`sed -n "s:[[:blank:]]*version=\"\(.*\)\",:\1:p" setup.py` \
    && echo "New version name: $VERSION+git${GIT_HASH}pt${TORCH_VERSION}${CUDA_VERSION}${EXTRA_VERSION}" \
    && sed -i "s/$VERSION/$VERSION+git${GIT_HASH}pt${TORCH_VERSION}${CUDA_VERSION}${EXTRA_VERSION}/" setup.py
RUN FORCE_CUDA=1 pip wheel -v --disable-pip-version-check --no-cache-dir --no-build-isolation --config-settings "--build-option=--cpp_ext" --config-settings "--build-option=--cuda_ext" ./
WORKDIR /
# ###############################################################################################################
# LIETORCH
RUN git clone https://github.com/princeton-vl/lietorch.git
WORKDIR lietorch
RUN git checkout 0fa9ce8 # 'master' branch at 03/25/24
RUN git submodule update --init --recursive
RUN GIT_HASH=$(git rev-parse --short HEAD) \
    && VERSION=`sed -n "s:[[:blank:]]*version='\(.*\)',:\1:p" setup.py` \
    && echo "New version name: $VERSION+git${GIT_HASH}pt${TORCH_VERSION}${CUDA_VERSION}${EXTRA_VERSION}" \
    && sed -i "s/$VERSION/$VERSION+git${GIT_HASH}pt${TORCH_VERSION}${CUDA_VERSION}${EXTRA_VERSION}/" setup.py
# From:
# '-gencode=arch=compute_60,code=sm_60', 
# '-gencode=arch=compute_61,code=sm_61', 
# '-gencode=arch=compute_70,code=sm_70', 
# '-gencode=arch=compute_75,code=sm_75',
# '-gencode=arch=compute_75,code=compute_75',
# To:
# '-gencode=arch=compute_80,code=sm_80',
# '-gencode=arch=compute_86,code=sm_86',
# '-gencode=arch=compute_89,code=sm_89',
# '-gencode=arch=compute_90,code=sm_90',
# '-gencode=arch=compute_100,code=sm_100',
# '-gencode=arch=compute_120,code=sm_120',
# '-gencode=arch=compute_120,code=compute_120',
RUN sed -i -e "s/'-gencode=arch=compute_60,code=sm_60',//g" setup.py
RUN sed -i -e "s/'-gencode=arch=compute_61,code=sm_61',//g" setup.py
RUN sed -i -e "s/'-gencode=arch=compute_70,code=sm_70',//g" setup.py
RUN sed -i -e "s/'-gencode=arch=compute_75,code=sm_75',//g" setup.py
RUN sed -i -e "s/'-gencode=arch=compute_75,code=compute_75',/'-gencode=arch=compute_80,code=sm_80','-gencode=arch=compute_86,code=sm_86','-gencode=arch=compute_89,code=sm_89','-gencode=arch=compute_90,code=sm_90','-gencode=arch=compute_100,code=sm_100','-gencode=arch=compute_120,code=sm_120','-gencode=arch=compute_120,code=compute_120',/g" setup.py
RUN sed -i 's!DISPATCH_GROUP_AND_FLOATING_TYPES(group_id, X.type()!DISPATCH_GROUP_AND_FLOATING_TYPES(group_id, X.scalar_type()!g' /lietorch/lietorch/src/lietorch_gpu.cu /lietorch/lietorch/src/lietorch_cpu.cpp
RUN sed -i 's!DISPATCH_GROUP_AND_FLOATING_TYPES(group_id, a.type()!DISPATCH_GROUP_AND_FLOATING_TYPES(group_id, a.scalar_type()!g' /lietorch/lietorch/src/lietorch_gpu.cu /lietorch/lietorch/src/lietorch_cpu.cpp
RUN sed -i 's!AT_DISPATCH_FLOATING_TYPES_AND_HALF(volume.type()!AT_DISPATCH_FLOATING_TYPES_AND_HALF(volume.scalar_type()!g' /lietorch/lietorch/extras/corr_index_kernel.cu
RUN sed -i 's!at::ScalarType _st = ::detail::scalar_type(the_type);!at::ScalarType _st = TYPE;!g' /lietorch/lietorch/include/dispatch.h
RUN pip wheel . --verbose
WORKDIR /
# ###############################################################################################################
# NVDIFFRAST
RUN git clone https://oauth2:$GITLAB_TOKEN@gitlab-master.nvidia.com/nrs/nre_external/nvdiffrast.git
WORKDIR nvdiffrast
RUN git checkout dc1dedfd48de9be566d0cfde3ba96a710cc71014 # patches at 02/16/2024
RUN GIT_HASH=$(git rev-parse --short HEAD) \
    && VERSION=`sed -n "s:^__version__ = '\(.*\)':\1:p" nvdiffrast/__init__.py` \
    && echo "New version name: $VERSION+git${GIT_HASH}pt${TORCH_VERSION}${CUDA_VERSION}${EXTRA_VERSION}" \
    && sed -i "s/$VERSION/$VERSION+git${GIT_HASH}pt${TORCH_VERSION}${CUDA_VERSION}${EXTRA_VERSION}/" nvdiffrast/__init__.py
RUN pip wheel . --verbose --no-deps
WORKDIR /
# ###############################################################################################################
# TORCHSCATTER
RUN git clone https://github.com/rusty1s/pytorch_scatter.git
WORKDIR pytorch_scatter
RUN git checkout 6cf77c420f837a427b0d57965e414d68c1bd89ec # TOT at 2025-04-25
RUN GIT_HASH=$(git rev-parse --short HEAD) \
    && VERSION=`sed -n "s:^__version__ = '\(.*\)':\1:p" torch_scatter/__init__.py` \
    && echo "New version name: $VERSION+git${GIT_HASH}pt${TORCH_VERSION}${CUDA_VERSION}${EXTRA_VERSION}" \
    && sed -i "s/$VERSION/$VERSION+git${GIT_HASH}pt${TORCH_VERSION}${CUDA_VERSION}${EXTRA_VERSION}/" setup.py \
    && sed -i "s/$VERSION/$VERSION+git${GIT_HASH}pt${TORCH_VERSION}${CUDA_VERSION}${EXTRA_VERSION}/" torch_scatter/__init__.py
RUN FORCE_CUDA=1 python setup.py develop
RUN pip install wheel
RUN FORCE_CUDA=1 python setup.py bdist_wheel --dist-dir=dist
WORKDIR /
# ###############################################################################################################
# FUSED-SSIM
RUN git clone https://oauth2:$GITLAB_TOKEN@gitlab-master.nvidia.com/nrs/nre_external/fused-ssim.git
WORKDIR fused-ssim
RUN git checkout e86e6f920458ac931f1928b28adb0c0bfbb27cba # patches at 10/27/2024
RUN GIT_HASH=$(git rev-parse --short HEAD) \
    && VERSION=`sed -n "s:^__version__ = '\(.*\)':\1:p" setup.py` \
    && echo "New version name: $VERSION+git${GIT_HASH}pt${TORCH_VERSION}${CUDA_VERSION}${EXTRA_VERSION}" \
    && sed -i "s/$VERSION/$VERSION+git${GIT_HASH}pt${TORCH_VERSION}${CUDA_VERSION}${EXTRA_VERSION}/" setup.py
RUN pip wheel . --verbose --no-deps
WORKDIR /
# ###############################################################################################################
# MMCV
RUN git clone https://oauth2:$GITLAB_TOKEN@gitlab-master.nvidia.com/nrs/nre_external/mmcv
WORKDIR mmcv
RUN git checkout 3a5fb4b # version 2.2.0
RUN GIT_HASH=$(git rev-parse --short HEAD) \
    && VERSION=`sed -n "s:^__version__ = '\(.*\)':\1:p" mmcv/version.py` \
    && echo "New version name: $VERSION+git${GIT_HASH}pt${TORCH_VERSION}${CUDA_VERSION}${EXTRA_VERSION}" \
    && sed -i "s/$VERSION/$VERSION+git${GIT_HASH}pt${TORCH_VERSION}${CUDA_VERSION}${EXTRA_VERSION}/" mmcv/version.py \
    && sed -i "s/__version__.split/__version__.split(\"+\")[0].split/" mmcv/version.py
RUN FORCE_CUDA=1 pip wheel . --verbose --no-deps
WORKDIR /
# ###############################################################################################################
# MAMBA-SSM
RUN git clone https://github.com/state-spaces/mamba
WORKDIR mamba
RUN git checkout e0761ece1db07e0949dd88b4f4cd440420a19fd9 # TOT at 2025-07-22
# Remove unncessary gencode from setup.py
RUN sed -i '175,193d' setup.py
RUN GIT_HASH=$(git rev-parse --short HEAD) \
    && FORCE_CUDA=1 MAMBA_LOCAL_VERSION=git${GIT_HASH}pt${TORCH_VERSION}${CUDA_VERSION}${EXTRA_VERSION} MAMBA_FORCE_BUILD=TRUE python setup.py bdist_wheel
WORKDIR /
# ###############################################################################################################
# Causal-conv1d
RUN git clone https://github.com/Dao-AILab/causal-conv1d
WORKDIR causal-conv1d
RUN git checkout 933203064542689e7827bb98c90227f096e8a845 # TOT at 2025-08-22
# Remove unncessary gencode from setup.py
RUN sed -i '176,196d' setup.py
RUN GIT_HASH=$(git rev-parse --short HEAD) \
    && FORCE_CUDA=1 CAUSAL_CONV1D_LOCAL_VERSION=git${GIT_HASH}pt${TORCH_VERSION}${CUDA_VERSION}${EXTRA_VERSION} CAUSAL_CONV1D_FORCE_BUILD=TRUE python setup.py bdist_wheel
WORKDIR /
# ###############################################################################################################
# SAM2 (Segment Anything Model 2)
# No Nvidia patch, we only need to pre-build the wheel for Bazel build determinism.
# Use the official PyPI sdist (1.1.0) since the source in https://github.com/facebookresearch/sam2.git is not
# an exact match
RUN wget -q -O - https://files.pythonhosted.org/packages/ce/11/d07fc96688f731a85de6d5260e98b709051eded2b7b5667ae292530bcf90/sam2-1.1.0.tar.gz | tar xz -C / && mv /sam2-1.1.0 /sam2
WORKDIR /sam2
RUN VERSION=`sed -n "s:^VERSION = \"\(.*\)\":\1:p" setup.py` \
    && echo "New version name: ${VERSION}+pt${TORCH_VERSION}${CUDA_VERSION}${EXTRA_VERSION}" \
    && sed -i "s/^NAME = \"SAM-2\"/NAME = \"sam2\"/" setup.py \
    && sed -i "s/^VERSION = \"${VERSION}\"/VERSION = \"${VERSION}+pt${TORCH_VERSION}${CUDA_VERSION}${EXTRA_VERSION}\"/" setup.py
# --no-build-isolation to let the build find CUDA on aarch64, and don't allow errors to avoid falling back to
# pure-Python wheel in case of build failure
RUN SAM2_BUILD_ALLOW_ERRORS=0 pip wheel . --verbose --no-deps --no-build-isolation
WORKDIR /
# ###############################################################################################################
# TWINE UPLOADS
RUN mkdir wheels
WORKDIR wheels
RUN mv /OpenUSD/packaging/wheelhouse/usd_core-*.whl .
RUN mv /decord/python/decord-*.whl .
RUN mv /TransformerEngine/dist/transformer_engine-*.whl .
RUN mv /TransformerEngine/dist/flash_attn-*.whl .
RUN mv /apex/apex-*.whl .
RUN mv /lietorch/lietorch-*.whl .
RUN mv /nvdiffrast/nvdiffrast-*.whl .
RUN mv /pytorch_scatter/dist/torch_scatter-*.whl .
RUN mv /fused-ssim/fused_ssim-*.whl .
RUN mv /mmcv/mmcv-*.whl .
RUN mv /mamba/dist/mamba_ssm-*.whl .
RUN mv /causal-conv1d/dist/causal_conv1d-*.whl .
RUN mv /sam2/sam2-*.whl .

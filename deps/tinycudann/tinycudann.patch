# Patch tinycudann to support TCNN_CACHE_DIR environment variable
# This allows redirecting the RTC cache to a writable location when the
# venv site-packages is read-only (e.g., with Bazel's py_venv_binary).
# Default to ~/.cache/tinycudann instead of the package directory.

--- a/tinycudann/modules.py
+++ b/tinycudann/modules.py
@@ -77,8 +77,13 @@ _rtc_dir = os.path.join(os.path.dirname(__file__), "rtc")
 _rtc_include_dir = os.path.join(_rtc_dir, "include")
 _C.rtc_set_include_dir(_rtc_include_dir)
 
-_rtc_cache_dir = os.path.join(_rtc_dir, "cache")
-os.makedirs(_rtc_cache_dir, exist_ok=True)
+# Allow overriding cache directory via TCNN_CACHE_DIR environment variable.
+# Default to ~/.cache/tinycudann for read-only venv support (e.g., Bazel py_venv_binary).
+_rtc_cache_dir = os.environ.get("TCNN_CACHE_DIR")
+if _rtc_cache_dir is None:
+    _rtc_cache_dir = os.path.join(os.path.expanduser("~"), ".cache", "tinycudann")
+if not os.path.exists(_rtc_cache_dir):
+    os.makedirs(_rtc_cache_dir, exist_ok=True)
 _C.rtc_set_cache_dir(_rtc_cache_dir)
 
 def _torch_precision(tcnn_precision):


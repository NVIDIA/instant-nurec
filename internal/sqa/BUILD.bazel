load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library")
load("@mypy_integration//:mypy.bzl", "mypy_test")
load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("//internal/sqa/test_cases:defs.bzl", "LITE_TEST_CASES")
load(":defs.bzl", "test_plan_targets")

DEFAULT_VISIBILITY = ["//:core_package_group"]

package(default_visibility = DEFAULT_VISIBILITY)

exports_files(
    ["README.md"],
    # For validation of auto-generated documentation
    visibility = ["//internal/sqa/test_cases:__pkg__"],
)

py_library(
    name = "pylib",
    srcs = ["run_tests.py"],
    data = [
        "//internal/sqa/scripts",
        "//internal/sqa/scripts:create_comparison_gif",
    ] + list(depset([
        resource
        for test_case in LITE_TEST_CASES
        for resource in test_case.get("resources", [])
    ]).to_list()),
    deps = [
        "//internal/sqa/test_cases:pylib",
        pip_requirement("click"),
        "@rules_python//python/runfiles",
    ],
)

# This is an entry point for running the full set of test cases available in the SQA test plan, or chosen subsets
# (with optional debug arguments). Only Docker execution is supported. See README.md for usage instructions.
py_binary(
    name = "run_tests",
    srcs = ["run_tests.py"],
    main = "run_tests.py",
    deps = [":pylib"],
)

mypy_test(
    name = "run_tests_mypy",
    timeout = "long",
    deps = [
        ":run_tests",
    ],
)

# This defines all Bazel targets for SQA-style test cases integrated for usage as "bazel test".
# Two types of tests are generated for each test case:
# - "sqa_test-<test_identifier>" (runfiles-based, cacheable)
# - "sqa_docker_test-<test_identifier>" (Docker-based, external)
# See README.md for usage instructions.
test_plan_targets(
    srcs = ["run_tests.py"],
    lite_test_cases = LITE_TEST_CASES,
    deps = [":pylib"],
)

# Test suite to explicitly include all SQA runfiles-based test cases (including manual ones)
test_suite(
    name = "sqa_test_suite",
    tags = ["manual"],
    tests = [":sqa_test--" + test_case["name"] for test_case in LITE_TEST_CASES],
)

# Test suite to explicitly include all SQA docker test cases (including manual ones)
test_suite(
    name = "sqa_docker_test_suite",
    tags = ["manual"],
    tests = [":sqa_docker_test--" + test_case["name"] for test_case in LITE_TEST_CASES],
)

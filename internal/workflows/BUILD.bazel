load("@rules_python//python:defs.bzl", "py_library")

DEFAULT_VISIBILITY = [
    "//:core_package_group",
    "//bazel/docs:__pkg__",
]

package(default_visibility = DEFAULT_VISIBILITY)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        # Add visibility for //internal/workflows/cluster_toolbox:...
        "//internal/workflows/cluster_toolbox:__subpackages__",
    ],
    deps = [],
)

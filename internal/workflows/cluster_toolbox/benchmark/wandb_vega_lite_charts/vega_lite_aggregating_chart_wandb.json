{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "scale": { "continuousPadding": 30 }
  },
  "data": { "name": "wandb" },
  "title": "${string:title}",
  "encoding": {
    "x": {
      "field": "${field:date}",
      "type": "temporal",
      "title": "${string:xlabel}",
      "timeUnit": "utcyearmonthdatehoursminutes",
      "axis": {
        "labelAngle": -70
      }
    },
    "y": {
      "field": "${field:metric}",
      "type": "quantitative",
      "title": "${string:ylabel}",
      "scale": { "zero": false }
    }
  },
  "layer": [
    {
      "selection": {
        "grid": {
          "type": "interval",
          "bind": "scales"
        }
      },
      "mark": {
        "type": "point",
        "size": 30,
        "opacity": 0.3
      },
      "encoding": {
        "tooltip": [
          {
            "field": "${field:version}",
            "title": "Version",
            "type": "nominal"
          },
          {
            "field": "${field:date}",
            "title": "${string:date_label}",
            "type": "nominal",
            "timeUnit": "utcyearmonthdatehoursminutesseconds",
            "scale": { "type": "utc" }
          },
          {
            "field": "${field:dataset}",
            "title": "Dataset",
            "type": "nominal"
          },
          {
            "field": "${field:metric}",
            "title": "${string:metric_name}",
            "type": "quantitative"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "${field:metric}",
              "as": "${field:metric}"
            },
            { "op": "max", "field": "${field:date}", "as": "${field:date}" },
            {
              "op": "max",
              "field": "${field:version}",
              "as": "${field:version}"
            }
          ],
          "groupby": ["${field:version}"]
        }
      ],
      "mark": {
        "type": "line",
        "size": 2,
        "interpolate": "monotone",
        "color": "#467fb4",
        "point": {
          "shape": "circle",
          "filled": false,
          "fill": "white",
          "size": 50
        }
      },
      "encoding": {
        "tooltip": [
          {
            "field": "${field:version}",
            "title": "Version",
            "type": "nominal"
          },
          {
            "field": "${field:date}",
            "title": "${string:date_label}",
            "type": "nominal",
            "timeUnit": "utcyearmonthdatehoursminutesseconds",
            "scale": { "type": "utc" }
          },
          {
            "field": "${field:metric}",
            "title": "Mean ${string:metric_name}",
            "type": "quantitative"
          }
        ]
      }
    }
  ]
}

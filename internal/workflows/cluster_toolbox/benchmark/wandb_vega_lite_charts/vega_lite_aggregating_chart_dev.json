      }
    ]
  },
  "width": 600,
  "height": 500,
  "title": "MyPlot",
  "encoding": {
    "x": {
      "field": "commit_date",
      "type": "temporal",
      "title": "Commit Date",
      "timeUnit": "utcyearmonthdatehoursminutes",
      "axis": {
        "labelAngle": -70
      }
    },
    "y": {
      "field": "accuracy",
      "type": "quantitative",
      "title": "Mean accuracy",
      "scale": { "zero": false }
    }
  },
  "layer": [
    {
      "selection": {
        "grid": {
          "type": "interval",
          "bind": "scales"
        }
      },
      "mark": {
        "type": "point",
        "size": 30,
        "opacity": 0.3
      },
      "encoding": {
        "tooltip": [
          {
            "field": "version",
            "title": "Version",
            "type": "nominal"
          },
          {
            "field": "commit_date",
            "title": "Commit Date",
            "type": "nominal",
            "timeUnit": "utcyearmonthdatehoursminutesseconds",
            "scale": { "type": "utc" }
          },
          {
            "field": "dataset",
            "title": "Dataset",
            "type": "nominal"
          },
          {
            "field": "accuracy",
            "title": "Accuracy",
            "type": "quantitative"
          }
        ]
      }
    },
    {
      // Interactive zooming (see https://vega.github.io/vega-lite-v4/docs/zoom.html)
      "transform": [
        {
          "aggregate": [
            { "op": "mean", "field": "accuracy", "as": "accuracy" },
            { "op": "max", "field": "commit_date", "as": "commit_date" },
            { "op": "max", "field": "version", "as": "version" }
          ],
          "groupby": ["sweep"]
        }
      ],
      "mark": {
        "type": "line",
        "size": 2,
        "interpolate": "monotone",
        "color": "#467fb4",
        "point": {
          "shape": "circle",
          "filled": false,
          "fill": "white",
          "size": 50
        }
      },
      "encoding": {
        "tooltip": [
          {
            "field": "version",
            "title": "Version",
            "type": "nominal"
          },
          {
            "field": "commit_date",
            "title": "Commit Date",
            "type": "nominal",
            "timeUnit": "utcyearmonthdatehoursminutesseconds",
            "scale": { "type": "utc" }
          },
          {
            "field": "accuracy",
            "title": "Mean Accuracy",
            "type": "quantitative"
          }
        ]
      }
    }
  ]
}

load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# Shared line classification module used by coverage tools
py_library(
    name = "line_classifier",
    srcs = ["line_classifier.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
)

# Export Python scripts for coverage tools
exports_files(
    [
        "infer_ncu_coverage.py",
        "line_classifier.py",
    ],
    visibility = ["//visibility:public"],
)

# NCU coverage wrapper for use with bazel coverage --run_under
# Usage: bazel coverage --config=cuda_device_coverage //target:test
sh_binary(
    name = "ncu_coverage_wrapper",
    srcs = ["ncu_coverage_wrapper.sh"],
    data = [
        "infer_ncu_coverage.py",
        "line_classifier.py",
    ],
    visibility = ["//visibility:public"],
)

# Generate baseline coverage data (zero-count LCOV) for executable lines in all source files
# Usage: bazel run //internal/scripts/cuda_coverage:generate_baseline_coverage -- -s /path/to/workspace -o baseline.dat
py_binary(
    name = "generate_baseline_coverage",
    srcs = ["generate_baseline_coverage.py"],
    main = "generate_baseline_coverage.py",
    visibility = ["//visibility:public"],
    deps = [":line_classifier"],
)

# Postprocess coverage data - cleans LCOV output for genhtml
# Usage: bazel run //internal/scripts/cuda_coverage:postprocess_coverage -- input.dat -o output.info
py_binary(
    name = "postprocess_coverage",
    srcs = ["postprocess_coverage.py"],
    main = "postprocess_coverage.py",
    visibility = ["//visibility:public"],
    deps = [":line_classifier"],
)

# Combined coverage script for running host + device coverage, merging, and generating HTML
# Usage: bazel run //internal/scripts/cuda_coverage:run_combined_coverage
sh_binary(
    name = "run_combined_coverage",
    srcs = ["run_combined_coverage.sh"],
    visibility = ["//visibility:public"],
)

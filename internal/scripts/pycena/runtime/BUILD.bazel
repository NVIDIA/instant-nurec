# Final obfuscated entry point of the 'pycena_nre_tools' target with all dependencies
sh_binary(
    name = "pycena_nre_tools",
    srcs = ["entrypoint.sh"],
    data = [
        ":pycena_nre_tools_venv_deps",
        "//bazel/version:workspace_status.sh",  # used for runtime version determination from the pycena_run binary
        "//configs",
        "//internal/scripts/pycena:pycena_nre_tools_cc",
    ] + NRE_TOOLS_LIBS + select({
        "//bazel/conditions:all_tools": NCORE_AUX_DATA_REPO_LIBS + NCORE_AUX_DATA_DATA_DEPS,
        "//bazel/conditions:ncore_aux_data": NCORE_AUX_DATA_REPO_LIBS + NCORE_AUX_DATA_DATA_DEPS,
        "//conditions:default": [],
    }) + select({
        "//bazel/conditions:all_tools": ASSET_HARVESTER_DATA,
        "//bazel/conditions:asset_harvester": ASSET_HARVESTER_DATA,
        "//conditions:default": [],
    }),
    visibility = [
        "//apps:__pkg__",
        # Add visibility for SQA tests
        "//internal/sqa:__pkg__",
    ],
    deps = [
        "@bazel_tools//tools/bash/runfiles",
    ],
)


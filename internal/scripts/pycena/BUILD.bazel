# Note that the internal packages (not listed above) are not part of pycena

# There is a need to dynamically generate config.yaml from run.yaml as there is more than one version of run.py in //:run_py.
# For the tiny one-liner gRPC entrypoint, it must set skip_script=False so that import and call both get obfuscated to the same symbol;
# skip_script tells obfuscator to "Leave the entry‐point script (run.py or run_grpc_only_py) in its original shape - only remap
# its imports and skip mangling its function definitions".
genrule(
    name = "gen_config_run",
    srcs = [
        "configs/run.yaml",
        "//:gen_run.py",
    ],
    outs = ["config_run.yaml"],
    cmd = "sed 's|script: run.py|script: $(location //:gen_run.py)|;" + select({
        # Toggle skip_script in case we are generating the gRPC-only run.py
        "//bazel/conditions:run_grpc_only": "s|skip_script: True|skip_script: False|",
        # Keep original config as is
        "//conditions:default": "",
    }) + "' $(location configs/run.yaml) > $@",
)

run_binary(
    name = "pycena_run_srcs",
    srcs = [
        ":config_run.yaml",
        ":templates",
        "//:gen_run.py",
        # Include non-Python data needed at runtime (YAML templates, exemplar map, asset bank)
        "//nre/utils/io/asset_harvester_tools:asset_harvester_data_lib",
        "//nre/utils/io/asset_harvester_tools:asset_bank_files",
    ] + PY_FILES_NRE,
    outs = [
        "run_header.h",
        "run_source.cpp",
    ],
    args = [
        "--config=$(location :config_run.yaml)",
        "$(location run_header.h)",
        "$(location run_source.cpp)",
    ],
    tool = ":pycena",
)

# Common compiler / linker options for the compiled cc targets
CC_COPTS = [
    "-fvisibility=hidden",
    "-fno-rtti",
]

CC_LINKOPTS = [
    "-Wl,--no-undefined",
    "-Wl,--as-needed",
    "-Wl,--strip-all",
    "-Wl,--gc-sections",
]

cc_binary(
    name = "pycena_run_cc",
    srcs = [
        ":run_header.h",
        ":run_source.cpp",
    ],
    copts = CC_COPTS,
    data = [
        "@rules_python//python/bin:python",
    ],
    linkopts = CC_LINKOPTS,
    visibility = ["__subpackages__"],
    deps = [
        "@rules_python//python/cc:current_py_cc_headers",
        "@rules_python//python/cc:current_py_cc_libs",
    ],
)

# Obfuscation of //nre/nrm:run

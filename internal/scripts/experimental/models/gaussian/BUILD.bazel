    main = "animate_gaussians.py",
    visibility = ["//scripts/ci:__pkg__"],
    # Only include deps that are directly imported by animate_gaussians.py
    deps = [
        # Pip packages
        pip_requirement("torch"),
        pip_requirement("imageio"),
        pip_requirement("click"),
        pip_requirement("hydra-core"),
        pip_requirement("omegaconf"),
        pip_requirement_internal("chumpy"),
        pip_requirement_internal("wis3d"),
        pip_requirement_internal("orjson"),
        pip_requirement_internal("moviepy"),
        pip_requirement_internal("scenepic"),
        pip_requirement_internal("aist-plusplus-api"),
        pip_requirement_internal("sentencepiece"),
        # GenMO
        "@genmo//:hmr4d",
        "@genmo//:motiondiff",
        "//internal/scripts/experimental/models/gaussian/genmo:genmo_utils",
        # NVHuman lib (has its own nre deps)
        "//internal/scripts/experimental/models/gaussian/nvhuman:nvhuman_lib",
        # NRE deps (only what's directly imported)
        "//nre/utils:pylib_gaussian_render",  # RenderConfig, render_ply_orbit
    ],

load("@aspect_rules_py//py:defs.bzl", "py_binary")
load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
    visibility = [
        "//scripts/pycena:__pkg__",
    ],
)

filegroup(
    name = "animation_files",
    srcs = [
        "animate_nvhuman.py",
        "gaussian_to_nvhuman.py",
        "tools/__init__.py",
        "tools/utils.py",
    ],
    visibility = [
        "//scripts/pycena:__subpackages__",
    ],
)
################################################################
# Library for parent package
################################################################

py_library(
    name = "nvhuman_lib",
    srcs = [
        "animate_nvhuman.py",
        "gaussian_nvhuman_layer.py",
        "gaussian_to_nvhuman.py",
        "tools/utils.py",
    ],
    visibility = ["//internal/scripts/experimental/models/gaussian:__pkg__"],
    # Only include deps that are actually imported by these files
    deps = [
        # Pip packages
        pip_requirement("torch"),
        pip_requirement("numpy"),
        pip_requirement("scipy"),
        pip_requirement("imageio"),
        pip_requirement("click"),
        pip_requirement("tqdm"),
        # GenMO/NVHuman
        "//internal/scripts/experimental/models/gaussian/genmo:genmo_utils",
        # NRE deps (only what's actually imported)
        "//nre/utils:pylib_gaussian_render",  # RenderConfig, render_gaussians_single_view
        "//nre/utils:pylib_geometry",  # quat_mult_xyzw, so3_matrix_to_quat
        "//nre/models/gaussians:pylib",  # PLYGaussianLoader
        "//nre/utils/io:pylib",  # save_ply
    ],
)

################################################################
# PyBinary rules
################################################################

py_binary(
    name = "animate_nvhuman",
    srcs = [
        "animate_nvhuman.py",
        "gaussian_nvhuman_layer.py",
        "tools/utils.py",
    ],
    data = [
        "//configs",
    ],
    main = "animate_nvhuman.py",
    visibility = ["//scripts/ci:__pkg__"],
    deps = [
        # Pip packages
        pip_requirement("torch"),
        pip_requirement("numpy"),
        pip_requirement("scipy"),
        pip_requirement("pillow"),
        pip_requirement("opencv-python"),
        pip_requirement("imageio"),
        pip_requirement("imageio-ffmpeg"),
        pip_requirement("setuptools"),
        pip_requirement("click"),
        pip_requirement("click-default-group"),
        pip_requirement("tqdm"),
        pip_requirement("kiui"),
        # GenMO/NVHuman
        "//internal/scripts/experimental/models/gaussian/genmo:genmo_utils",
        # NRE deps (using targets with proper visibility)
        "//nre/utils:pylib_gaussian_render",
        "//nre/utils:pylib_geometry",
        "//nre/models/gaussians:pylib",
        "//nre/utils/io:pylib",
    ],
)

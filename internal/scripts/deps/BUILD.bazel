# nre:allow-rules-python-py-binary
load("@rules_python//python:defs.bzl", "py_binary")

# uv.lock (TOML) at repo root for Black Duck. Uses uv from multitool.
# Requires network and, for private GitLab indexes, credentials (e.g. ~/.netrc).
# Only analyzed when explicitly built/run (e.g. bazel run //:generate_lock); does not affect standard builds.
py_binary(
    name = "generate_lock",
    srcs = ["run_uv_lock.py"],
    data = [
        "//deps/python:requirements_3_11_x86_64.txt",
        "@multitool//tools/uv",
    ],
    main = "run_uv_lock.py",
    tags = ["requires-network"],
    visibility = [
        "//:__pkg__",
        "//deps/python:__pkg__",
    ],
    deps = ["@rules_python//python/runfiles"],
)

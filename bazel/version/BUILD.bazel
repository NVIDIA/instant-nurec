exports_files(["workspace_status.sh"])

# This directory contains the core components of NRE's version determination
# system, which handles both build-time and run-time version information.
# The relationship between build-time and run-time version determination is
# intricate and involves several components working together.
#
# OVERVIEW:
# ---------
# NRE uses a hybrid approach for version determination that adapts to different
# execution environments:
# 1. Build-time: Creates version_file.yaml with baked-in version info
# 2. Run-time: Dynamically determines version from git repository when available
#
# KEY COMPONENTS:
# ---------------
# 1. workspace_status.sh - Dual-purpose script (see detailed explanation below)
# 2. version_file_yaml.sh - Converts bazel status output to YAML format
# 3. version_file.yaml - Build-time generated version file (genrule target)
# 4. version_string.sh - Generates semantic version strings from git history (invoked by workspace_status.sh)
# 5. VERSION_FILE - Contains major/minor version numbers (manually maintained)
# 6. nre/config/version.py - Runtime version determination logic, main entry point at code runtime
#
# WORKSPACE_STATUS.SH - DUAL ROLE:
# ---------------------------------
# This script serves two critical functions:
#
# 1. BAZEL STATUS COMMAND (Build-time):
#    - Configured in .bazelrc as `--workspace_status_command`
#    - Executed by Bazel at every build invocation
#    - Source for bazel-out/stable-status.txt containing git commit info, version strings, etc.
#    - This output is consumed by version_file_yaml.sh to generate version_file.yaml
#    - Variables prefixed with 'STABLE_' affect cache invalidation
#
# 2. DIRECT RUNTIME EXECUTION:
#    - Called directly by non-bazel python environments at runtime for version inference
#    - Used when the environment has access to the source git repository
#    - Enables dynamic version determination without pre-built version files
#
# BUILD-TIME VS RUN-TIME VERSION DETERMINATION:
# ----------------------------------------------
#
# BUILD-TIME (version_file.yaml):
# - Generated during build process via the genrule below
# - Contains "baked-in" version information from the build moment
# - Changes with each newly merged MR due to auto-incrementing patch versions
#   / git hash inclusions
# - Used in environments where source git repository is *not* available
# - Primary use case: Docker images/containers where git repo is inaccessible
# - Cache Impact: Previously caused build/test cache invalidation on every MR due
#   to patch version increments / git hash inclusions
#
# RUN-TIME (direct workspace_status.sh execution):
# - Dynamically determines version from current git repository state
# - Only works in non-sandboxed execution environments with git repo access
# - Prevents cache invalidation by avoiding static file dependencies
# - Used in bazel run environments and python-env executions
# - Limitations: Not available in sandboxed test environments
#
# VERSION DETERMINATION PRIORITY (nre/config/version.py logic):
# -------------------------------------------------------------
# The runtime version determination follows this priority order:
#
# 1. BUILD-TIME VERSION FILE (version_file.yaml):
#    - Used when version file is available (primarily in Docker containers/built images)
#    - Contains pre-baked version info from build time
#    - Ensures version availability even without git repository access
#
# 2. RUNTIME GIT REPOSITORY ACCESS (workspace_status.sh):
#    - Used when version_file.yaml is not available AND git repo is accessible
#    - Provides current/live version information
#    - Available in bazel run environments and python-env
#
# 3. FALLBACK/EMPTY VERSION:
#    - Used in sandboxed environments (e.g., test sandboxes, doc building)
#    - Intentionally returns empty/default version to prevent cache invalidation
#    - Only when allow_empty=True is set
#
# CACHE INVALIDATION IMPLICATIONS:
# --------------------------------
# The version system is designed to minimize unnecessary cache invalidations:
#
# - version_file.yaml is only used in built images (git repository is unavailable)
# - Runtime environments use direct git repository access via workspace_status.sh
# - Test sandboxes intentionally get empty version (no cache invalidation)
# - Only Docker image layers change between MRs (explicit, isolated change)
#
# EXECUTION ENVIRONMENT BEHAVIOR:
# -------------------------------
# 1. SANDBOXED TEST ENVIRONMENTS:
#    - No access to source git repository
#    - No version_file.yaml dependency to avoid cache invalidation
#    - Returns empty/default version (when allow_empty=True)
#    - Treat availibility of version information as a special case in unit tests
#
# 2. DOCKER CONTAINERS/BUILT IMAGES:
#    - No access to source git repository
#    - Relies on pre-built version_file.yaml for version information
#    - Version information is "frozen" at build time
#
# 3. BAZEL RUN ENVIRONMENTS:
#    - Has access to source git repository
#    - Uses workspace_status.sh for live version determination
#    - Avoids cache invalidation by not depending on version_file.yaml
#
# 4. PYTHON-ENV EXECUTIONS:
#    - Has access to source git repository (tied to source repo)
#    - Directly calls workspace_status.sh for runtime version inference
#    - Provides current version information without build dependencies
#
# VERSION STRING FORMAT:
# ----------------------
# Generated version strings follow the pattern:
# MAJOR.MINOR.PATCH-<GIT_COMMIT_SHA_SHORT[+dirty]>
#
# Where:
# - MAJOR.MINOR: Stored in VERSION_FILE (manually maintained)
# - PATCH: Auto-calculated from merge commits since last VERSION_FILE change
# - GIT_COMMIT_SHA_SHORT: 8-character git commit hash
# - +dirty: Suffix when workspace has uncommitted changes
#
# DEVELOPER NOTES:
# ----------------
# - When modifying this system, be mindful of cache invalidation impacts
# - Test changes in both sandboxed and non-sandboxed environments
# - Ensure Docker images still receive proper version information
# - Consider the impact on build/test performance when making changes
# - The version_file.yaml genrule below should remain minimal to reduce
#   unnecessary rebuilds when only visibility changes occur
#
# ==============================================================================

# This genrule generates a version file in YAML format that contains the
# current version information of the NRE project. It should only be included in
# the Docker images that are used for running NRE applications.
#
# IMPORTANT: This target should *NOT* be used as a dependency for runtime
# version determination in most cases, as it would cause build/test cache
# results to be invalidated frequently due to patch version increments on
# every MR merge.
#
# The generated version_file.yaml is primarily intended for:
# - Docker containers/built images where source git repository is not available
# - Environments that need version information but cannot access git directly
#
# For runtime version determination in environments with git access, use
# the direct workspace_status.sh execution approach instead (see above).
genrule(
    name = "version_file_yaml",
    outs = ["version_file.yaml"],
    cmd_bash = "$(location version_file_yaml.sh) > $(location version_file.yaml)",
    stamp = 1,  # Enables access to workspace status information
    tools = ["version_file_yaml.sh"],
    visibility = [
        # Add visibility for //:run_image
        "//:__pkg__",

        # Add visibility for //apps/aux_gen:ncore_aux_data_image

        # Add visibility for //apps/asset_harvester:__pkg__

        # Add visibility for //internal/scripts/pycena/runtime:pycena_run_test

        # Add visibility for //instant_nurec/nre/grpc:pylib
        "//instant_nurec/nre/grpc:__pkg__",

        # Add visibility for //instant_nurec/nre/render:pylib
        "//instant_nurec/nre/render:__pkg__",

        # Add visibility for //apps:nre_tools

        # Add visibility for //internal/scripts/ds_to_ncore:__pkg__

        # Add visibility for //internal/scripts/test_data:generate_test_data
    ],
)

# Tar archive of the version file to use as container image layer.
pkg_tar(
    name = "version_file_yaml_tar",
    srcs = [
        "//bazel/version:version_file_yaml",
    ],
    compressor = "@pigz//:pigz",
    extension = "tar.gz",
    package_dir = "/",
    tags = [
        "manual",
        "no-remote-cache",
    ],
    visibility = [
        # Add visibility for run image
        "//:__pkg__",

        # Add visibility for tools image

        # Add visibility for NRM image
        "//instant_nurec/nre/nrm:__pkg__",
    ],
)

# Export the VERSION_FILE to be used by the release scripts
exports_files(
    ["VERSION_FILE"],
    visibility = [
        # Add visibility for //internal/scripts/release:__pkg__
    ],
)

diff --git a/py/tools/venv_fixup/main.py b/py/tools/venv_fixup/main.py
new file mode 100644
index 0000000..4c8c245
--- /dev/null
+++ b/py/tools/venv_fixup/main.py
@@ -0,0 +1,80 @@
+#!/usr/bin/env python3
+"""Rewrite venv symlinks to bypass execroot/_main/external symlinks.
+
+After py_venv_binary creates the venv, site-packages symlinks point through
+execroot/_main/external/<repo>/ which Bazel recreates during analysis for
+every invocation (even no-ops). If we attempt to 'bazel run' the same target
+concurrently in multiple processes, there is a race conditition between the
+first process importing the venv and the second one refreshing symlinks,
+causing random ModuleNotFoundError.
+
+The venv binary writes relative symlinks computed within the Bazel action's
+working directory (execroot/_main/). These relative paths traverse
+execroot/_main/external/<repo>/ (volatile) rather than going directly to
+<output_base>/external/<repo>/ (a stable real directory).
+
+The fix: for pip-package and git-repo symlinks, prepend ../../ to the existing
+relative target. This skips the two volatile execroot/_main/ components and
+points directly to the stable <output_base>/external/<repo>/ directory.
+
+Symlinks that go through bazel-out/ (e.g. build outputs like .so files compiled
+from external git repos) are already stable and must not be rewritten.
+"""
+
+import os
+import sys
+
+
+def collect_symlinks(root):
+    """Walk the tree using scandir(), using cached DirEntry.is_symlink()."""
+    symlinks = []
+    dirs_to_visit = [root]
+    while dirs_to_visit:
+        d = dirs_to_visit.pop()
+        try:
+            with os.scandir(d) as it:
+                for entry in it:
+                    if entry.is_symlink():
+                        symlinks.append(entry.path)
+                        # Don't descend into symlinked dirs
+                    elif entry.is_dir(follow_symlinks=False):
+                        dirs_to_visit.append(entry.path)
+        except PermissionError:
+            pass
+    return symlinks
+
+
+def rewrite_chunk(chunk):
+    for path in chunk:
+        target = os.readlink(path)
+        if "external/" not in target:
+            continue
+        # Build outputs (e.g. gsplat/csrc.so) go through bazel-out/ — those are
+        # already stable real paths and must not be rewritten.
+        abs_target = os.path.normpath(os.path.join(os.path.dirname(path), target))
+        if "bazel-out/" in abs_target:
+            continue
+        # Prepend ../../ to skip the two volatile execroot/_main/ components that
+        # the venv binary's relative target currently traverses.
+        os.unlink(path)
+        os.symlink("../../" + target, path)
+
+
+def main():
+    venv_dir = sys.argv[1]
+    entries = collect_symlinks(venv_dir)
+
+    workers = os.cpu_count() or 4
+    pids = []
+    for i in range(workers):
+        pid = os.fork()
+        if pid == 0:
+            rewrite_chunk(entries[i::workers])
+            os._exit(0)
+        pids.append(pid)
+    for pid in pids:
+        os.waitpid(pid, 0)
+
+
+if __name__ == "__main__":
+    main()

load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

DEFAULT_VISIBILITY = [
    "//:core_package_group",
    "//bazel/docs:__pkg__",
]

package(default_visibility = DEFAULT_VISIBILITY)

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
    visibility = [
        "//internal/scripts/pycena:__pkg__",
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "feature_extractor.py",
        "perceptual_utils.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        # Add visibility for //internal/scripts/bench
        "//internal/scripts/bench:__pkg__",
    ],
    deps = [
        pip_requirement("numpy"),
        pip_requirement("opencv-python"),
        pip_requirement("pillow"),
        pip_requirement("scikit-image"),
        pip_requirement("scipy"),
        pip_requirement("torch"),
        pip_requirement("torchvision"),
        pip_requirement("transformers"),
    ],
)

pytest_test(
    name = "feature_extractor_test",
    size = "medium",
    srcs = [
        "feature_extractor_test.py",
    ],
    deps = [
        ":pylib",
        "//nre/metrics:pylib_utils",
    ],
)

pytest_test(
    name = "perceptual_utils_test",
    size = "small",
    srcs = [
        "perceptual_utils_test.py",
    ],
    deps = [
        ":pylib",
    ],
)

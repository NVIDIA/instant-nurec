load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

DEFAULT_VISIBILITY = [
    "//:core_package_group",
    "//bazel/docs:__pkg__",
]

package(default_visibility = DEFAULT_VISIBILITY)

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
    visibility = [
        "//internal/scripts/pycena:__pkg__",
    ],
)

# Separate library for metric.py to avoid circular dependency
py_library(
    name = "pylib_metric",
    srcs = [
        "metric.py",
        "types.py",
    ],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        pip_requirement("torch"),
        pip_requirement("numpy"),
        pip_requirement("pyyaml"),
        "//nre/config:pylib",
        "//nre/datasets:pylib",
        "//nre/utils:pylib",
        "//nre/utils:pylib_types",
    ],
)

# Separate library for utils.py to avoid circular dependency
py_library(
    name = "pylib_utils",
    srcs = [
        "utils.py",
    ],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        pip_requirement("torch"),
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        # Add visibility for //internal/scripts/bench
        "//internal/scripts/bench:__pkg__",
    ],
    deps = [
        "//nre/metrics/impl:pylib",
    ],
)

py_library(
    name = "pylib_compute",
    srcs = [
        "compute_metrics.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        # Add visibility for //:run
        "//:__pkg__",
    ],
    deps = [
        "//nre/metrics:pylib_metric",
        "//nre/metrics/impl:pylib",
    ],
)

pytest_test(
    name = "metric_test",
    size = "medium",
    srcs = [
        "metric_test.py",
    ],
    deps = [
        ":pylib",
    ],
)

pytest_test(
    name = "utils_test",
    size = "medium",
    srcs = [
        "utils_test.py",
    ],
    deps = [
        ":pylib",
    ],
)

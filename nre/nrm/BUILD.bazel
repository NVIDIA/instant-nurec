load("@aspect_rules_py//py:defs.bzl", "py_image_layer", "py_library")

# nre:allow-py-venv-binary - py_venv_binary used for better perf and multiprocess-safety of deliverables
load("@aspect_rules_py//py/unstable:defs.bzl", "py_venv_binary")
load("@mypy_integration//:mypy.bzl", "mypy_test")
load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//:pkg.bzl", "pkg_tar")
load("//bazel/pytest:defs.bzl", "pytest_test")
load("//bazel/rules_oci:default_layer_groups.bzl", "default_layer_groups")

exports_files(
    ["run.py"],
    visibility = ["//internal/scripts/pycena:__pkg__"],
)

py_library(
    name = "pylib",
    srcs = ["run.py"],
    data = ["//configs"],
    deps = [
        pip_requirement("click"),
        pip_requirement("click-default-group"),
        pip_requirement("pytorch_lightning"),
        "//nre/config:pylib",
        "//nre/nrm/config:pylib",
        "//nre/nrm/models:pylib",
        "//nre/nrm/systems:pylib",
        "//nre/utils:pylib_callbacks",
        "//nre/viewer:pylib",
    ],
)

py_venv_binary(
    name = "run",
    main = "run.py",
    deps = [":pylib"],
)

# This utility is designed for use in mGPU scenarios on SLURM, it requires a build-time venv
# even though it's not a deliverable.
py_venv_binary(
    name = "probe_cluster_env",
    srcs = ["probe_cluster_env.py"],
    main = "probe_cluster_env.py",
    deps = [":pylib"],
)

pytest_test(
    name = "nrm_test",
    timeout = "long",
    srcs = [
        "nrm_test.py",
    ],
    data = [
        "//configs",
        "@test_data_ncore//:ncore_1sec",
    ],
    deps = [
        ":pylib",
        pip_requirement("click"),
        "@rules_python//python/runfiles",
    ],
)

mypy_test(
    name = "run_mypy",
    timeout = "long",
    deps = [
        ":pylib",
    ],
)

################################################################
# Container Image Rules
################################################################

# Layer for HOME directory writable by all users
# (ex. to receive default cache folder for various Python dependencies, though
# this won't be persisted in our typical container invocations).
pkg_tar(
    name = "home_dir_tar",
    compressor = "@pigz//:pigz",
    empty_dirs = ["/home"],
    extension = "tar.gz",
    mode = "0777",
    tags = [
        "manual",
    ],
)

# OCI image layer for NRM 'run' binary
py_image_layer(
    name = "nrm_run_image_layer",
    binary = "run",
    compressor = "@pigz//:pigz",
    compressor_args = "-n",
    layer_groups = default_layer_groups(),
    root = "/app/",
    tags = [
        "manual",
        "no-remote-cache",
    ],
)

oci_image(
    name = "nrm_run_image_oci",
    base = "@nre_run_image_oci",
    entrypoint = ["/app/nre/nrm/run"],
    env = {
        "HOME": "/home",
        "TORCHINDUCTOR_CACHE_DIR": "/tmp/torchinductor",
    },
    tags = [
        "manual",
        "no-remote-cache",
    ],
    tars = [
        ":nrm_run_image_layer",
        ":home_dir_tar",
        "//bazel/version:version_file_yaml_tar",  # put last in the list of tar files to make this the last / often changing layer
    ],
    workdir = "/app/nre/nrm/run.runfiles/_main",
)

# Build the image and load it into a local runtime:
# $ bazel run //nre/nrm:load_nrm_run_image_oci
# $ docker run -it --rm --gpus all nvcr.io/nvidian/ct-toronto-ai/nre_nrm_run:latest
oci_load(
    name = "load_nrm_run_image_oci",
    image = ":nrm_run_image_oci",
    repo_tags = ["nvcr.io/nvidian/ct-toronto-ai/nre_nrm_run:latest"],
    tags = [
        "manual",
        "no-remote-cache",
    ],
)

# Push the image to the registry:
# $ bazel run //nre/nrm:push_nrm_run_image_oci [-- --tag ${TAG}]
# Note: Don't push the 'latest' tag from local builds, we reserve this to images generated by post-merge pipelines in CI.
#       A custom tag can be specific on the above command if needed.
oci_push(
    name = "push_nrm_run_image_oci",
    image = ":nrm_run_image_oci",
    repository = "nvcr.io/nvidian/ct-toronto-ai/nre_nrm_run",  # this can be overriden by providing --repository
    tags = [
        "manual",
        "no-remote-cache",
    ],
)

# Obfuscated NRM run image (same pattern as nre_obfuscated_run for //nre/nrm:run)
py_image_layer(
    name = "pycena_nrm_run_image_layer",
    binary = "//internal/scripts/pycena/runtime:pycena_nrm_run",
    compressor = "@pigz//:pigz",
    compressor_args = "-n",
    layer_groups = default_layer_groups(),
    root = "/app/",
    tags = [
        "manual",
        "no-remote-cache",
    ],
)

oci_image(
    name = "obfuscated_nrm_run_image_oci",
    base = "@nre_run_image_oci",
    entrypoint = ["/app/internal/scripts/pycena/runtime/pycena_nrm_run"],
    env = {
        "HOME": "/home",
        "TORCHINDUCTOR_CACHE_DIR": "/tmp/torchinductor",
    },
    tags = [
        "manual",
        "no-remote-cache",
    ],
    tars = [
        ":pycena_nrm_run_image_layer",
        ":home_dir_tar",
        "//bazel/version:version_file_yaml_tar",
    ],
)

# Build the image and load it into a local runtime:
# $ bazel run //nre/nrm:load_obfuscated_nrm_run_image_oci
# $ docker run -it --rm --gpus all nvcr.io/nvidian/ct-toronto-ai/nre_obfuscated_nrm_run:latest
oci_load(
    name = "load_obfuscated_nrm_run_image_oci",
    image = ":obfuscated_nrm_run_image_oci",
    repo_tags = ["nvcr.io/nvidian/ct-toronto-ai/nre_obfuscated_nrm_run:latest"],
    tags = [
        "manual",
        "no-remote-cache",
    ],
)

# Push the image to the registry:
# $ bazel run //nre/nrm:push_obfuscated_nrm_run_image_oci [-- --tag ${TAG}]
# Note: Don't push the 'latest' tag from local builds, we reserve this to images generated by post-merge pipelines in CI.
#       A custom tag can be specified on the above command if needed.
oci_push(
    name = "push_obfuscated_nrm_run_image_oci",
    image = ":obfuscated_nrm_run_image_oci",
    repository = "nvcr.io/nvidian/ct-toronto-ai/nre_obfuscated_nrm_run",  # can be overridden by providing --repository
    tags = [
        "manual",
        "no-remote-cache",
    ],
)

load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

DEFAULT_VISIBILITY = [
    # Broader visibility so others could take this
    "//:core_package_group",
]

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
    visibility = [
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "dataset.py",
        "models.py",
        "nrm.py",
        "predict.py",
    ],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        "//libs/losses:pylib_orchestration_config",
        pip_requirement("pydantic"),
        pip_requirement("omegaconf"),
        pip_requirement("numpy"),
        "//nre/config:pylib",
        "//nre/utils:pylib",
    ],
)

pytest_test(
    name = "schema_test",
    timeout = "long",
    srcs = ["schema_test.py"],
    data = [
        "//configs",
    ],
    shard_count = 8,
    deps = [
        ":pylib",
    ],
)

load("@aspect_rules_py//py:defs.bzl", "py_binary")
load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

DEFAULT_VISIBILITY = [
    "//nre/nrm:__subpackages__",
]

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
    visibility = [
        "//internal/scripts/pycena:__pkg__",
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "datamodule.py",
        "nrm_base.py",
        "nrm_dataverse.py",
        "nrm_ncore.py",
        "nrm_ncore_websocket.py",
        "registry.py",
        "samplers.py",
    ],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        pip_requirement("dataverse"),
        pip_requirement("nvidia-ncore"),
        pip_requirement("nvidia-ncore-internal"),
        pip_requirement("pandas"),
        pip_requirement("pytorch_lightning"),
        pip_requirement("universal-pathlib"),
        pip_requirement("s3fs"),
        pip_requirement("torch"),
        pip_requirement("websockets"),
        "//libs/vren:pylib",
        "//nre/datasets:pylib",
        "//nre/datasets:pylib_tracks",
        "//nre/nrm/config:pylib",
        "//nre/utils:pylib_files",
        "//nre/utils:pylib_misc",
        "//nre/utils:pylib_ncore_utils",
        "//nre/utils:pylib_types",
    ],
)

pytest_test(
    name = "nrm_dataverse_test",
    srcs = ["nrm_dataverse_test.py"],
    data = [
        "@test_data_dataverse//:dl3dv",
        "@test_data_dataverse//:mvimgnet",
        "@test_data_dataverse//:re10k",
    ],
    deps = [
        ":pylib",
        "@rules_python//python/runfiles",
    ],
)

pytest_test(
    name = "samplers_test",
    srcs = ["samplers_test.py"],
    deps = [
        ":pylib",
        "@rules_python//python/runfiles",
    ],
)

py_binary(
    name = "ncore_benchmark",
    srcs = ["ncore_benchmark.py"],
    data = [
        "//configs",
    ],
    main = "ncore_benchmark.py",
    deps = [
        ":pylib",
        pip_requirement("click"),
    ],
)

load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

DEFAULT_VISIBILITY = [
    "//nre/nrm:__subpackages__",
]

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
    visibility = [
    ],
)

py_library(
    name = "pylib_trajectory",
    srcs = ["trajectory.py"],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        "//nre/nrm/config:pylib",
        "//nre/utils:pylib_geometry",
        "//nre/utils:pylib_types",
        pip_requirement("nvidia-ncore"),
        pip_requirement("torch"),
    ],
)

py_library(
    name = "pylib_motion",
    srcs = ["motion.py"],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        # Type-check-time only: motion.py guards `from nre.datasets.tracks import CuboidTracks`
        # behind `if TYPE_CHECKING`, but mypy still resolves it. Without this dep edge, narrow
        # mypy_test targets (e.g. blocks_test_mypy) raise [import-untyped].
        "//nre/datasets:pylib_tracks",
        pip_requirement("torch"),
    ],
)

py_library(
    name = "pylib_cubemap",
    srcs = ["cubemap.py"],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        "//libs/vren:pylib",
        "//nre/utils:pylib_profiling",
        pip_requirement("torch"),
        pip_requirement("einops"),
        pip_requirement("nvidia-ncore"),
        pip_requirement("nvdiffrast"),
    ],
)

py_library(
    name = "pylib_covariance",
    srcs = ["covariance.py"],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        "//nre/utils:pylib_geometry",
        pip_requirement("torch"),
        pip_requirement("torch_scatter"),
    ],
)

pytest_test(
    name = "covariance_test",
    srcs = ["covariance_test.py"],
    deps = [
        ":pylib_covariance",
        "//nre/utils:pylib_geometry",
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "sensor.py",
    ],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        ":pylib_cubemap",
        ":pylib_motion",
        ":pylib_trajectory",
        pip_requirement("torch"),
        pip_requirement("omegaconf"),
        pip_requirement("nvidia-ncore"),
        pip_requirement("numpy"),
    ],
)

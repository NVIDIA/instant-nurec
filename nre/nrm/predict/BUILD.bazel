load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

DEFAULT_VISIBILITY = [
    "//nre/nrm:__subpackages__",
]

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
    visibility = [
    ],
)

py_library(
    name = "pylib_primitive_merge",
    srcs = [
        "__init__.py",
        "primitive_merge.py",
    ],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        "//nre/nrm/config:pylib",
        "//nre/nrm/primitives:pylib",
        "//nre/nrm/utils:pylib_covariance",
        "//nre/nrm/utils:pylib_cubemap",
        "//nre/nrm/utils:pylib_trajectory",
        "//nre/utils:pylib",
        "//nre/utils:pylib_types",
        pip_requirement("torch"),
        pip_requirement("torch_scatter"),
        pip_requirement("nvidia-ncore"),
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "export_ply.py",
    ],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        ":pylib_primitive_merge",
        "//nre/datasets:pylib_tracks",
        "//nre/nrm/config:pylib",
        "//nre/nrm/primitives:pylib",
        "//nre/nrm/utils:pylib_trajectory",
        "//nre/utils:pylib",
        "//nre/utils:pylib_types",
        pip_requirement("torch"),
        pip_requirement("nvidia-ncore-internal"),
    ],
)

pytest_test(
    name = "primitive_merge_test",
    srcs = ["primitive_merge_test.py"],
    deps = [
        ":pylib_primitive_merge",
        "//nre/nrm/utils:pylib",
        "//nre/utils:pylib",
    ],
)

pytest_test(
    name = "export_ply_test",
    srcs = ["export_ply_test.py"],
    deps = [
        ":pylib",
        "//nre/nrm/config:pylib",
        "//nre/nrm/primitives:pylib",
        "//nre/nrm/utils:pylib",
    ],
)

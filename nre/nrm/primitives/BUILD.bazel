load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")

DEFAULT_VISIBILITY = [
    # Broader visibility so renderer could take this
    "//:core_package_group",
    # Asset Harvester requires NRM primitive to initiate training
]

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
    visibility = [
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "base.py",
        "kelvin_primitive.py",
    ],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        pip_requirement("omegaconf"),
        pip_requirement("torch"),
        "//nre/models:pylib",
        "//nre/models/gaussians:pylib",
        "//nre/nrm/config:pylib",
        "//nre/nrm/utils:pylib_cubemap",
        "//nre/utils:pylib_geometry",
        "//nre/utils:pylib_misc",
        "//nre/utils:pylib_types",
    ],
)

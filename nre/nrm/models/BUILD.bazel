load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

DEFAULT_VISIBILITY = [
    "//nre/nrm:__subpackages__",
]

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
    visibility = [
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "activations.py",
        "base.py",
        "kelvin_model.py",
        "post_processing.py",
    ],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        pip_requirement("omegaconf"),
        pip_requirement("torch"),
        pip_requirement("torchvision"),
        pip_requirement("numpy"),
        pip_requirement("einops"),
        pip_requirement("safetensors"),
        "//nre/config:pylib_version",
        "//nre/datasets:pylib_tracks",
        "//nre/models:pylib_nn_extensions",
        "//nre/nrm/config:pylib",
        "//nre/nrm/models/blocks:pylib",
        "//nre/nrm/models/kelvin_backbone:pylib",
        "//nre/nrm/primitives:pylib",
        "//nre/nrm/utils:pylib",
        "//nre/utils:pylib",
        "//nre/utils:pylib_files",
        "//nre/utils:pylib_misc",
        "//nre/utils:pylib_profiling",
        "//nre/utils:pylib_types",
    ],
)

load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

DEFAULT_VISIBILITY = ["//:core_package_group"]

package(default_visibility = DEFAULT_VISIBILITY)

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
    visibility = [
        "//internal/scripts/pycena:__pkg__",
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "eval_ground_mesh.py",
        "eval_rendering_metrics.py",
        "gt_from_ncore.py",
        "mesh_processing.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        # Add visibility for //:run
        "//:__pkg__",
    ],
    deps = [
        "//nre/artifact:pylib",
        "//nre/benchmark/utils:pylib",
        "//nre/metrics/impl:pylib",
        "//nre/utils:pylib",
        "//nre/utils/io/export:pylib",
        pip_requirement("click"),
        pip_requirement("dataclasses-json"),
        pip_requirement("matplotlib"),
        pip_requirement("nvidia-ncore"),
        pip_requirement("numpy"),
        pip_requirement("opencv-python"),
        pip_requirement("pandas"),
        pip_requirement("pillow"),
        pip_requirement("point_cloud_utils"),
        pip_requirement("pyyaml"),
        pip_requirement("scipy"),
        pip_requirement("torch"),
        pip_requirement("torchvision"),
        pip_requirement("tqdm"),
        pip_requirement("trimesh"),
    ],
)

pytest_test(
    name = "mesh_processing_test",
    size = "medium",
    srcs = [
        "mesh_processing_test.py",
    ],
    deps = [
        ":pylib",
    ],
)

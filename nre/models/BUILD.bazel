#
# Phase 1 step 4.3: predict-only standalone keeps __init__.py + nn_extensions.py
# + nrenderable.py + utils.py. The full nre/models/ tree (background, calib,
# feature_volume, input_embedding, object_feature_volume, tracks_calib,
# composite, custom_modules, post_processing, post_processings/) was for
# training/eval and has been removed.

load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//:core_package_group"])

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
    visibility = [],
)

py_library(
    name = "pylib_nn_extensions",
    srcs = ["nn_extensions.py"],
    deps = [
        pip_requirement("torch"),
        pip_requirement("lietorch"),
        "//nre/utils:pylib_geometry",
    ],
)

py_library(
    name = "pylib_utils",
    srcs = ["utils.py"],
    deps = [
        pip_requirement("torch"),
        pip_requirement("omegaconf"),
        "//nre/models/base:pylib",
        "//nre/utils:pylib",
        "//nre/utils:pylib_misc",
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "nrenderable.py",
    ],
    deps = [
        ":pylib_nn_extensions",
        ":pylib_utils",
        pip_requirement("torch"),
        pip_requirement("nvidia-ncore"),
        pip_requirement("numpy"),
        pip_requirement("lietorch"),
        "//nre/models/base:pylib",
        "//nre/utils:pylib",
        "//nre/utils:pylib_types",
    ],
)

#
# Phase 1 step 4.3: predict-only standalone keeps just the renderer + ply
# writer helpers. Strategies, initializations, gaussians_composite, the
# full gaussian model, and the strategy/collect submodules are all training-
# only and have been removed.

load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = [
    "//:core_package_group",
])

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
    visibility = [],
)

# gsplat is selected by config but the predict path with render_video.enabled=false
# does not exercise it. The dep is kept so renderers.py imports resolve.
py_library(
    name = "pylib_cc_gsplat",
    visibility = ["//nre/models/gaussians:__pkg__"],
    deps = select({
        "//bazel/conditions:local_gsplat": [
            "@gsplat_repo_local//:pylib_cc",
        ],
        "//conditions:default": [
            "@gsplat_repo//:pylib_cc",
        ],
    }),
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "renderers.py",
        "utils.py",
    ],
    visibility = ["//:core_package_group"],
    deps = [
        pip_requirement("nvidia-ncore"),
        pip_requirement("numpy"),
        pip_requirement("point-cloud-utils"),
        pip_requirement("torch"),
        pip_requirement("tqdm"),
        pip_requirement("lietorch"),
        ":pylib_cc_gsplat",
        "//libs/geometry/kernels:pylib",
        "//libs/nrend:pylib",
        "//nre/datasets:pylib",
        "//nre/models:pylib",
        "//nre/models/base:pylib",
        "//nre/utils:pylib",
        "//nre/utils:pylib_types",
    ],
)

load("@aspect_rules_py//py:defs.bzl", "py_binary")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

package(default_visibility = ["//:core_package_group"])

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
    visibility = [
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "collector.py",
        "collector_slang.py",
    ],
    deps = [
        "//libs/slang_gaussians:pylib",
        "//libs/slang_utils:pylib_utils",
    ],
)

pytest_test(
    name = "collect_test",
    srcs = ["collect_test.py"],
    deps = [
        ":pylib",
    ],
)

py_binary(
    name = "benchmark_collector",
    srcs = ["benchmark_collector.py"],
    main = "benchmark_collector.py",
    deps = [
        ":pylib",
    ],
)

load("@rules_python//python:defs.bzl", "py_library")

DEFAULT_VISIBILITY = [
    "//:core_package_group",
    "//bazel/docs:__pkg__",
]

package(default_visibility = DEFAULT_VISIBILITY)

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
    visibility = [
    ],
)

py_library(
    name = "pylib_reporoot",
    srcs = [
        "repo_root.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        # Add visibility for //:run
        "//:__pkg__",
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        # Add visibility for //:run
        "//:__pkg__",
        # Add visibility for //apps
        "//apps:__pkg__",
    ],
    deps = [
        ":pylib_reporoot",
        "//nre/config:pylib_version",
        "//nre/utils:pylib_colored_exceptions",
        "//nre/utils:pylib_misc",
        "//nre/utils/debug:pylib",
    ] + select({
        "@//bazel/conditions:internal": [],
        "//conditions:default": [],
    }),
)

# Tracy default variant (CPU-only)
py_library(
    name = "pylib_tracy",
    srcs = [
        "__init__.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        "//:__pkg__",
    ],
    deps = [
        ":pylib_reporoot",
        "//nre/config:pylib_version",
        "//nre/utils:pylib_misc_tracy",
        "//nre/utils/debug:pylib",
    ] + select({
        "@//bazel/conditions:internal": [],
        "//conditions:default": [],
    }),
)

# Tracy GPU variant
py_library(
    name = "pylib_tracy_gpu",
    srcs = [
        "__init__.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        "//:__pkg__",
    ],
    deps = [
        ":pylib_reporoot",
        "//nre/config:pylib_version",
        "//nre/utils:pylib_misc_tracy_gpu",
        "//nre/utils/debug:pylib",
    ] + select({
        "@//bazel/conditions:internal": [],
        "//conditions:default": [],
    }),
)

load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

DEFAULT_VISIBILITY = ["//:core_package_group"]

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
    visibility = [
    ],
)

# Please see bazel/version/BUILD.bazel for more information on NRE's version determination system
py_library(
    name = "pylib_version",
    srcs = [
        "version.py",
    ],
    data = ["//bazel/version:workspace_status.sh"],
    visibility = DEFAULT_VISIBILITY + [
        # Add visibility for //:run
        "//:__pkg__",
        # Add visibility for //apps
        # Add visibility for //internal/scripts/kratos
        # Add visibility for //internal/workflows
    ],
    deps = [
        pip_requirement("pydantic"),
        pip_requirement("pyyaml"),
    ],
)

py_library(
    name = "pylib_trainer_config",
    srcs = ["trainer.py"],
    deps = [
        pip_requirement("pydantic"),
        ":pylib_base_schema",
    ],
)

py_library(
    name = "pylib_base_schema",
    srcs = ["base_schema.py"],
    deps = [
        pip_requirement("pydantic"),
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "base_schema.py",
        "logger.py",
        "model.py",
        "parse.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        # add visibility to //internal/scripts/experimental:ncore_to_ngp
        "//:asset_harvester_package_group",
    ],
    deps = [
        "//libs/losses:pylib_orchestration_config",
        pip_requirement("pydantic"),
        pip_requirement("omegaconf"),
        pip_requirement("shortuuid"),
        pip_requirement("hydra-core"),
        pip_requirement("nvidia-ncore"),
        ":pylib_base_schema",
        ":pylib_trainer_config",
        ":pylib_version",
        "//nre:pylib_reporoot",
        "//nre/utils:pylib_misc",
        "//nre/utils:pylib_trainer",
    ],
)


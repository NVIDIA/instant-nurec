load("@aspect_rules_py//py:defs.bzl", "py_binary")
load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("@rules_python//python:packaging.bzl", "py_wheel")

DEFAULT_VISIBILITY = [
    "//:core_package_group",
]

package(default_visibility = DEFAULT_VISIBILITY)

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
    visibility = [
        "//internal/scripts/pycena:__pkg__",
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "artifact.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        # add visibility to //internal/scripts/experimental:grpc_control_actors
        "//internal/scripts/experimental:__pkg__",
    ],
    deps = [
        pip_requirement("pyyaml"),
    ],
)

py_binary(
    name = "info",
    srcs = ["info.py"],
    main = "info.py",
    deps = [":pylib"],
)

py_wheel(
    name = "wheel",
    distribution = "nre_artifact",
    entry_points = {
        "console_scripts": [
            "usdz-info = nre.artifact.info:main",
        ],
    },
    homepage = "https://gitlab-master.nvidia.com/nrs/nre",
    platform = "any",
    requires = ["PyYAML"],
    version = "0.2.1",
    deps = [
        ":info",
        ":pylib",
    ],
)

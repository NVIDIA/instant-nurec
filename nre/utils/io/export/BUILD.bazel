load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

DEFAULT_VISIBILITY = ["//:core_package_group"]

package(default_visibility = DEFAULT_VISIBILITY)

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
    visibility = [
        "//internal/scripts/pycena:__pkg__",
    ],
)

py_library(
    name = "pylib_render",
    srcs = [
        "render.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        # Add visibility for //:run
        "//:__pkg__",
    ],
    deps = [
        "//nre/artifact:pylib",
        "//nre/render:pylib",
        "//nre/utils:pylib_cli",
        "//nre/utils:pylib_geometry",
        "//nre/utils:pylib_types",
        pip_requirement("click"),
        pip_requirement("imageio"),
        pip_requirement("imageio-ffmpeg"),
        pip_requirement("setuptools"),
        pip_requirement("torch"),
        pip_requirement("numpy"),
        pip_requirement("pillow"),
        pip_requirement("nvidia-ncore"),
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "artifact_structure.py",
        "custom_rig_trajectory.py",
        "depth.py",
        "ego_mask.py",
        "external_assets.py",
        "gaussian_export_accessor.py",
        "gaussian_plys.py",
        "gaussian_statistics.py",
        "gaussian_usd_asset.py",
        "gaussian_usd_writer.py",
        "ground_mesh.py",
        "mask_overlay.py",
        "mesh.py",
        "ncore_diagnostic.py",
        "ncore_tracks.py",
        "parsed_config.py",
        "point_cloud.py",
        "ppisp_usd_writer.py",
        "render.py",
        "render_grpc.py",
        "rig_trajectories.py",
        "sequence_tracks.py",
        "usdz_artifact.py",
    ],
    data = [
        "ppisp_usd_spg.slang",
        "ppisp_usd_spg.slang.lua",
        "ppisp_usd_spg.slang.usda",
    ],
    visibility = DEFAULT_VISIBILITY + [
        # Add visibility for //:run
        "//:__pkg__",
    ],
    deps = [
        "//nre/artifact:pylib",
        "//nre/config:pylib",
        "//nre/datamodules:pylib",
        "//nre/datasets:pylib",
        "//nre/grpc:pylib",
        "//nre/grpc/protos:grpc_pb2",
        "//nre/models:pylib",  # for PPISPPostProcessing in ppisp_usd_writer.py
        "//nre/models/gaussians:pylib",  # for GaussianExportFormat in gaussians_plys.py
        "//nre/render:pylib",
        "//nre/systems:pylib",
        "//nre/utils:pylib",
        "//nre/utils:pylib_cli",
        "//nre/utils:pylib_misc",
        "//nre/utils:pylib_ncore_utils",
        "//nre/utils:pylib_types",
        "//nre/utils/debug:pylib",
        "//nre/utils/io:pylib",
        "//nre/utils/upgrade:pylib",
        pip_requirement("aiofiles"),
        pip_requirement("click"),
        pip_requirement("torch"),
        pip_requirement("torchvision"),
        pip_requirement("lietorch"),
        pip_requirement("numpy"),
        pip_requirement("tqdm"),
        pip_requirement("pyyaml"),
        pip_requirement("pillow"),

#usda 1.0
(
    defaultPrim = "SlangPPISP"
)

def Shader "SlangPPISP"
{
    uniform token info:implementationSource = "sourceAsset"
    uniform asset info:spg:sourceAsset = @ppisp_usd_spg.slang@
    uniform token info:spg:sourceAsset:subIdentifier = "ppispProcess"

    # Exposure parameter
    float inputs:exposureOffset = 0.0

    # Vignetting parameters (per channel: R, G, B)
    float2 inputs:vignettingCenterR = (0.5, 0.5)
    float inputs:vignettingAlpha1R = 0.0
    float inputs:vignettingAlpha2R = 0.0
    float inputs:vignettingAlpha3R = 0.0

    float2 inputs:vignettingCenterG = (0.5, 0.5)
    float inputs:vignettingAlpha1G = 0.0
    float inputs:vignettingAlpha2G = 0.0
    float inputs:vignettingAlpha3G = 0.0

    float2 inputs:vignettingCenterB = (0.5, 0.5)
    float inputs:vignettingAlpha1B = 0.0
    float inputs:vignettingAlpha2B = 0.0
    float inputs:vignettingAlpha3B = 0.0

    # Color homography (3x3 matrix, identity default)
    matrix3d inputs:colorHomography = ((1, 0, 0), (0, 1, 0), (0, 0, 1))

    # CRF parameters (per channel: R, G, B)
    float inputs:crfX0R = 0.1
    float inputs:crfY0R = 0.1
    float inputs:crfSlopeP0R = 1.0
    float inputs:crfY0PreGammaR = 0.1
    float inputs:crfSlopeLineR = 1.0
    float inputs:crfGammaR = 2.2
    float inputs:crfX1R = 0.9
    float inputs:crfY1R = 0.9
    float inputs:crfSlopeP1R = 1.0
    float inputs:crfShoulderXR = 1.2
    float inputs:crfShoulderYR = 1.0

    float inputs:crfX0G = 0.1
    float inputs:crfY0G = 0.1
    float inputs:crfSlopeP0G = 1.0
    float inputs:crfY0PreGammaG = 0.1
    float inputs:crfSlopeLineG = 1.0
    float inputs:crfGammaG = 2.2
    float inputs:crfX1G = 0.9
    float inputs:crfY1G = 0.9
    float inputs:crfSlopeP1G = 1.0
    float inputs:crfShoulderXG = 1.2
    float inputs:crfShoulderYG = 1.0

    float inputs:crfX0B = 0.1
    float inputs:crfY0B = 0.1
    float inputs:crfSlopeP0B = 1.0
    float inputs:crfY0PreGammaB = 0.1
    float inputs:crfSlopeLineB = 1.0
    float inputs:crfGammaB = 2.2
    float inputs:crfX1B = 0.9
    float inputs:crfY1B = 0.9
    float inputs:crfSlopeP1B = 1.0
    float inputs:crfShoulderXB = 1.2
    float inputs:crfShoulderYB = 1.0

    # Image inputs/outputs
    opaque inputs:HdrColor
    opaque outputs:PPISPColor
}

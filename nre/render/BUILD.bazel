load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")

DEFAULT_VISIBILITY = [
    "//:core_package_group",
    "//bazel/docs:__pkg__",
]

package(default_visibility = DEFAULT_VISIBILITY)

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
    visibility = [
        "//internal/scripts/pycena:__pkg__",
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "actors.py",
        "render.py",
        "scene.py",
        "utils.py",
    ],
    visibility = DEFAULT_VISIBILITY + [
        # Add visibility for //:run
        "//:__pkg__",
        # Add visibility for rendering scripts at //internal/scripts/experimental:<rendering_example>
        "//internal/scripts/experimental:__pkg__",
        "//nre/nrm:__pkg__",
    ],
    deps = [
        "//libs/sensors:camera_kernels",
        "//libs/vren:pylib",
        "//libs/vren:pylib_cc",
        "//nre:pylib",
        "//nre/artifact:pylib",
        "//nre/config:pylib",
        "//nre/datasets:pylib",
        "//nre/models:pylib",
        "//nre/models/gaussians:pylib",
        "//nre/models/gaussians:pylib_gaussians_composite",
        "//nre/nrm/primitives:pylib",
        "//nre/systems:pylib",
        "//nre/utils:pylib",
        pip_requirement("einops"),
        pip_requirement("lietorch"),
        pip_requirement("numpy"),
        pip_requirement("nvidia-ncore"),
        pip_requirement("omegaconf"),
        pip_requirement("torch"),
    ],
)

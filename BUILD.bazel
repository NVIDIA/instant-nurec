#
# Phase 1 step 4.3: trimmed to package-group declarations + the format
# aliases. The legacy NRE-wide //run binary, gen_run_py genrule, the tracy
# variants, mypy_test, and all OCI image rules referenced deleted subtrees
# (nre/{benchmark,grpc,metrics,run,viewer,render}, internal/) and have been
# removed. The standalone predict pipeline lives at //instant_nurec:run.

# Formatting target aliases for convenience
alias(
    name = "format",
    actual = "//bazel/format:format",
)

alias(
    name = "format.check",
    actual = "//bazel/format:custom_check",
)

filegroup(
    name = "notices_file",
    srcs = ["NOTICES"],
    visibility = ["//visibility:public"],
)

package_group(
    name = "core_package_group",
    packages = [
        "//instant_nurec/...",
    ],
)

package_group(
    name = "aux_package_group",
    packages = [],
)

package_group(
    name = "asset_harvester_package_group",
    packages = [],
)

package_group(
    name = "mypy_typing_group",
    packages = [
        "//bazel/typing/...",
    ],
)

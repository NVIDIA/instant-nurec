load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")

DEFAULT_VISIBILITY = [
    "//instant_nurec/nre/nrm:__subpackages__",
]

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
    visibility = [
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "base.py",
        "decoders.py",
        "encoders.py",
        "sky.py",
    ],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        pip_requirement("torch"),
        pip_requirement("torchvision"),
        pip_requirement("numpy"),
        pip_requirement("einops"),
        "//instant_nurec/nre/datasets:pylib_tracks",
        "//instant_nurec/nre/models:pylib_nn_extensions",
        "//instant_nurec/nre/nrm/config:pylib",
        "//instant_nurec/nre/nrm/models/blocks:pylib",
        "//instant_nurec/nre/nrm/primitives:pylib",
        "//instant_nurec/nre/nrm/utils:pylib",
        "//instant_nurec/nre/utils:pylib",
        "//instant_nurec/nre/utils:pylib_files",
        "//instant_nurec/nre/utils:pylib_misc",
        "//instant_nurec/nre/utils:pylib_types",
    ],
)

#
# Phase 1 step 3 bazel target: launches the standalone Kelvin predict CLI.
# Until Phase 3 strips bazel, the canonical invocation is
#
#   bazel run //instant_nurec:run -- --ncore-path ... --output-dir ... --merge {none,frustum-ownership}
#
# Internally this delegates to nre.nrm.run.main with the appropriate Hydra
# overrides; the //nre/nrm:pylib dep brings in everything the underlying
# pipeline needs.

# nre:allow-py-venv-binary - py_venv_binary used for parity with //nre/nrm:run
load("@aspect_rules_py//py/unstable:defs.bzl", "py_venv_binary")
load("@aspect_rules_py//py:defs.bzl", "py_library")

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "cli.py",
        "config.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//nre/nrm:pylib",
    ],
)

py_venv_binary(
    name = "run",
    main = "cli.py",
    visibility = ["//visibility:public"],
    deps = [":pylib"],
)

load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")

DEFAULT_VISIBILITY = ["//:core_package_group"]

package(default_visibility = DEFAULT_VISIBILITY)

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
    visibility = [
    ],
)

py_library(
    name = "pylib_ncore_sensors_converters",
    srcs = ["ncore_sensors_converters.py"],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        "//libs/sensors:camera_kernels",
        pip_requirement("nvidia-ncore"),
        pip_requirement("torch"),
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "sensors.py",
    ],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        pip_requirement("torch"),
        pip_requirement("nvidia-ncore"),
        "//instant_nurec/_pkg/utils:pylib_geometry",
    ],
)


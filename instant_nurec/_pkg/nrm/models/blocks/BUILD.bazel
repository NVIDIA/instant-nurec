load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")

DEFAULT_VISIBILITY = [
    "//instant_nurec/_pkg/nrm:__subpackages__",
]

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
    visibility = [
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "aa_vit.py",
        "attention.py",
        "dav3.py",
        "dpt.py",
        "embeds.py",
        "layers.py",
    ],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        pip_requirement("torch"),
        pip_requirement("numpy"),
        pip_requirement("einops"),
        "//instant_nurec/_pkg/models:pylib_nn_extensions",
        "//instant_nurec/_pkg/nrm/utils:pylib",
        "//instant_nurec/_pkg/utils:pylib_geometry",
    ],
)

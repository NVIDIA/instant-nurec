load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")

DEFAULT_VISIBILITY = [
    "//instant_nurec/_pkg/nrm:__subpackages__",
]

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
    visibility = [
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "datamodule.py",
        "nrm_base.py",
        "nrm_ncore.py",
        "samplers.py",
    ],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        pip_requirement("nvidia-ncore"),
        pip_requirement("nvidia-ncore-internal"),
        pip_requirement("pandas"),
        pip_requirement("universal-pathlib"),
        pip_requirement("s3fs"),
        pip_requirement("torch"),
        "//instant_nurec/_pkg/datasets:pylib",
        "//instant_nurec/_pkg/datasets:pylib_tracks",
        "//instant_nurec/_pkg/nrm/config:pylib",
        "//instant_nurec/_pkg/utils:pylib_files",
        "//instant_nurec/_pkg/utils:pylib_misc",
        "//instant_nurec/_pkg/utils:pylib_ncore_utils",
        "//instant_nurec/_pkg/utils:pylib_types",
    ],
)

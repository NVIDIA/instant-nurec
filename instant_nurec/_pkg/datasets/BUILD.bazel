load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")

DEFAULT_VISIBILITY = [
    "//:core_package_group",
    "//bazel/docs:__pkg__",
]

package(default_visibility = DEFAULT_VISIBILITY)

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
    visibility = [
    ],
)

# Phase 1 step 4.3: predict-only standalone keeps a slim pylib that
# re-exports the tracks API + the cuboid helpers in utils.py.
py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "utils.py",
    ],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        pip_requirement("scipy"),
        pip_requirement("nvidia-ncore"),
        pip_requirement("nvidia-ncore-internal"),
        pip_requirement("opencv-python"),
        pip_requirement("imageio"),
        pip_requirement("imageio-ffmpeg"),
        pip_requirement("setuptools"),
        pip_requirement("einops"),
        pip_requirement("tqdm"),
        pip_requirement("numpy"),
        pip_requirement("torch"),
        pip_requirement("omegaconf"),
        pip_requirement("pillow"),
        pip_requirement("pandas"),
        pip_requirement("universal-pathlib"),
        pip_requirement("simplejpeg"),
        pip_requirement("cuml-cu12"),
        ":pylib_tracks",
        "//instant_nurec/_pkg/config:pylib",
        "//instant_nurec/_pkg/utils:pylib",
        "//instant_nurec/_pkg/utils:pylib_ncore_utils",
    ],
)

py_library(
    name = "pylib_vren_torch",
    srcs = ["_vren_torch.py"],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        pip_requirement("torch"),
    ],
)

py_library(
    name = "pylib_tracks",
    srcs = [
        "tracks.py",
    ],
    deps = [
        ":pylib_vren_torch",
        pip_requirement("torch"),
        pip_requirement("numpy"),
        "//instant_nurec/_pkg/utils:pylib",
        "//instant_nurec/_pkg/utils:pylib_se3_torch",
    ],
)


load("@aspect_rules_py//py:defs.bzl", "py_binary")
load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/slang:defs.bzl", "slangtorch_library")

DEFAULT_VISIBILITY = ["//:core_package_group"]

package(default_visibility = DEFAULT_VISIBILITY)

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
)

# Define constants for Slang losses
py_library(
    name = "def_constants",
    srcs = ["constants.py"],
    deps = [
        "//nre/utils:pylib_types",
    ],
)

# Generate compile-time constants for Slang losses
py_binary(
    name = "gen_constants",
    srcs = ["constants.py"],
    main = "constants.py",
    deps = [
        "//nre/utils:pylib_types",
    ],
)

# Generate compile-time constants file for Slang losses compilation
genrule(
    name = "constants_txt",
    outs = ["constants.txt"],
    cmd = "$(location :gen_constants) > $@",
    tools = [":gen_constants"],
)

# Compile the losses slang source into a SlangTorch C++ CUDA extension
slangtorch_library(
    name = "losses_slang_cc",
    srcs = [
        "losses.slang",
    ],
    extra_cmd_args = "$$(cat $(location :constants_txt)) -I$$(dirname $$(dirname $(location //libs/slang_utils:extensions_slang)))",
    deps = [
        ":constants_txt",
        "//libs/slang_utils:extensions_slang",
    ],
)

# Convert constants.txt -D flags into a header with #define directives.
# Single source of truth: constants.py (same genrule used by Slang).
genrule(
    name = "constants_cuda_h",
    srcs = [":constants_txt"],
    outs = ["constants_cuda.h"],
    cmd = "echo '// Auto-generated from constants.py. Do not edit.' > $@ && " +
          "cat $(location :constants_txt) | tr ' ' '\\n' | " +
          "sed 's/^-D\\(BLOCK_THREADS\\)/#define LOSSES_\\1/; " +
          "s/^-D\\(GRID_NUM_\\)/#define LOSSES_\\1/; " +
          "s/^-D\\(RGB_LABEL\\|DROPPED\\|INVALID\\|SKY_SEMANTIC\\|DIFIXED\\|SYNTHETIC\\)/#define LOSSES_FLAG_\\1/; " +
          "s/^-D/#define /; s/=/ /' >> $@",
)

# All CUDA loss kernels and Python bindings (replaces Slang losses + road gaussians)
# Each dispatch group is a separate .cu file for faster incremental builds.
# Constants are injected via a generated header from constants.py (same source of
# truth as Slang). The .cuh has #ifndef defaults for standalone builds.

cuda_library(
    name = "losses_cuda_cuda",
    srcs = [
        "losses_cuda_bg_grid.cu",  # Dispatch 4: Background texture & grid (TV + drift + spatial TV)
        "losses_cuda_camera.cu",  # Dispatch 1: Camera losses (RGB L1 + background MSE)
        "losses_cuda_gaussian.cu",  # Dispatch 3: Gaussian regularization (scale + density + z-scale + OOB)
        "losses_cuda_lidar.cu",  # Dispatch 2: LiDAR losses (L1 + BG MSE + intensity + raydrop)
        "losses_cuda_road_gaussians.cu",  # Dispatch 0: Road Gaussians
        ":constants_cuda_h",  # Generated constants (for -include in copts)
    ],
    hdrs = [
        "losses_cuda.cuh",
        "losses_cuda.h",
    ],
    copts = [
        # Force-include the generated constants header (from constants.py) before
        # any source, overriding the #ifndef defaults in losses_cuda.cuh.
        "--pre-include=constants_cuda.h",
        # Flags to be consistent with torch-cuda-extensions
        "-D__CUDA_NO_HALF_OPERATORS__",
        "-D__CUDA_NO_HALF_CONVERSIONS__",
        "-D__CUDA_NO_BFLOAT16_CONVERSIONS__",
        "-D__CUDA_NO_HALF2_OPERATORS__",
    ],
    includes = ["."],
    deps = [
        "//libs/kernel_utils:ku_cuda",
        "@nre_pip_deps//torch:torch_headers",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)

cc_binary(
    name = "losses_cuda_cc",
    srcs = ["losses_cuda_binding.cpp"],
    copts = [
        # Flags to be consistent with torch-cuda-extensions and to build correct torch-extension bindings
        "-DTORCH_API_INCLUDE_EXTENSION_H",
        "-DTORCH_EXTENSION_NAME=liblosses_cuda_cc",
    ],
    linkopts = [
        "-Wl,--no-undefined",
        "-Wl,--as-needed",
    ],
    linkshared = True,
    deps = [
        ":losses_cuda_cuda",
        "//libs/kernel_utils:ku_cc",
        "@nre_pip_deps//torch:libc10",
        "@nre_pip_deps//torch:libc10_cuda",
        "@nre_pip_deps//torch:libtorch_cpu",
        "@nre_pip_deps//torch:libtorch_python",
        "@nre_pip_deps//torch:torch_headers",
        "@rules_python//python/cc:current_py_cc_libs",
    ],
)

# Production target: CUDA kernels only (no Slang compilation).
py_library(
    name = "pylib_cc",
    srcs = [
        "__init__.py",
    ],
    data = [
        ":losses_cuda_cc",
    ],
    visibility = DEFAULT_VISIBILITY + [
        "//bazel/docs:__pkg__",
    ],
    deps = [
        pip_requirement("torch"),
    ],
)

# Test-only target: includes Slang kernels for A/B equivalence testing.
# SlangLossesFunction lazy-loads the Slang .so via __init__.py __getattr__.
py_library(
    name = "pylib_cc_with_slang",
    testonly = True,
    srcs = [
        "__init__.py",
    ],
    data = [
        ":losses_cuda_cc",
        ":losses_slang_cc",
    ],
    visibility = DEFAULT_VISIBILITY,
    deps = [
        pip_requirement("torch"),
    ],
)

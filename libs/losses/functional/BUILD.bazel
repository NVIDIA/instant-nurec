load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//:core_package_group"])

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "cuda_losses_function.py",
        "slang_losses_function.py",
    ],
    deps = [
        "//libs/losses/kernel:def_constants",
        "//libs/losses/kernel:pylib_cc",
        "//nre/utils:pylib_types",
        pip_requirement("torch"),
    ],
)

# Test-only: includes Slang kernels for equivalence testing.
py_library(
    name = "pylib_with_slang",
    testonly = True,
    deps = [
        ":pylib",
        "//libs/losses/kernel:pylib_cc_with_slang",
    ],
)

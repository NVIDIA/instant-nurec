load("@aspect_rules_py//py:defs.bzl", "py_binary")
load("@nre_pip_deps//:requirements.bzl", pip_requirement = "requirement")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")
load("//bazel/slang:defs.bzl", "slangtorch_library")

package(default_visibility = ["//:core_package_group"])

filegroup(
    name = "py_files",
    srcs = glob(["**/*.py"]),
)

COMMON_SLANG_FILES = [
    "common/ray_intersect.slang",
    "common/search.slang",
    "common/sigmoid.slang",
]

# Precompile the search tests Slang source into a binary module
genrule(
    name = "search_test_slang_module",
    srcs = [
        "common/search_test.slang",
        "common/search.slang",
    ],
    outs = ["common/search_test.slang-module"],
    cmd = select({
        "//bazel/conditions:coverage_mode": (
            "$(location //deps/slang:slangc) -g -line-directive-mode standard " +
            "$(location common/search_test.slang) -O0 -o $@"
        ),
        "//conditions:default": (
            "$(location //deps/slang:slangc) $(location common/search_test.slang) -O3 -o $@"
        ),
    }),
    tools = ["//deps/slang:slangc"],
)

# Filegroup for common slang files to be reused by other packages
filegroup(
    name = "common_slang_files",
    srcs = COMMON_SLANG_FILES + [
        "//libs/slang_utils:constants_slang",
        "//libs/slang_utils:extensions_slang",
    ],
)

# Compile the collector slang source into a SlangTorch C++ CUDA extension
# We have some pre-defined configurations that we pre-build for the configs
# we ship.
py_library(
    name = "pylib_codegen",
    srcs = [
        "collector/codegen/__init__.py",
        "collector/codegen/codegen.py",
    ],
)

# Precompile the Collector Slang source into a binary module
COLLECTOR_INCLUDES = (
    "-I$$(dirname $$(dirname $$(dirname $(location common/ray_intersect.slang)))) " +
    "-I$$(dirname $$(dirname $(location //libs/slang_utils:extensions_slang))) " +
    "-I$$(dirname $$(dirname $(location //libs/slang_utils:constants_slang))) " +
    "-I$$(dirname $$(dirname $$(dirname $(location //libs/geometry/kernels:quaternion.slang)))) "
)

genrule(
    name = "collector_slang_module",
    srcs = COMMON_SLANG_FILES + [
        "collector/collector.slang",
        "//libs/geometry/kernels:quaternion.slang",
        "//libs/geometry/kernels:transform.slang",
        "//libs/slang_utils:constants_slang",
        "//libs/slang_utils:extensions_slang",
    ],
    outs = ["collector/collector.slang-module"],
    cmd = select({
        "//bazel/conditions:coverage_mode": (
            "$(location //deps/slang:slangc) -g -line-directive-mode standard $(location collector/collector.slang) " +
            COLLECTOR_INCLUDES + "-O0 -o $@"
        ),
        "//conditions:default": (
            "$(location //deps/slang:slangc) $(location collector/collector.slang) " +
            COLLECTOR_INCLUDES + "-O3 -o $@"
        ),
    }),
    tools = ["//deps/slang:slangc"],
)

py_binary(
    name = "codegen",
    srcs = [
        "collector/codegen/codegen.py",
    ],
    main = "collector/codegen/codegen.py",
)

genrule(
    name = "generate_collector_prebuilt_configs",
    srcs = glob(["collector/collector_prebuilt_configs/*.json"]),
    outs = [
        "collector-default-configs.slang",
        "collector-default-configs.json",
    ],
    cmd = "$(location :codegen) --input-json $(SRCS) --output-slang $(location collector-default-configs.slang) --output-json $(location collector-default-configs.json)",
    tools = [":codegen"],
)

slangtorch_library(
    name = "collector_slang_cc",
    srcs = [
        "collector-default-configs.slang",
        ":collector_slang_module",
    ],
    deps = [
        "//libs/slang_utils:extensions_slang",
    ],
)

# Compile the MCMC slang source into a SlangTorch C++ CUDA extension
slangtorch_library(
    name = "mcmc_slang_cc",
    srcs = [
        "mcmc/mcmc.slang",
    ],
    extra_cmd_args = (
        "-I$$(dirname $$(dirname $$(dirname $(location common/ray_intersect.slang)))) " +
        "-I$$(dirname $$(dirname $(location //libs/slang_utils:extensions_slang))) " +
        "-I$$(dirname $$(dirname $$(dirname $(location //libs/geometry/kernels:quaternion.slang))))"
    ),
    deps = COMMON_SLANG_FILES + [
        "//libs/geometry/kernels:quaternion.slang",
        "//libs/slang_utils:constants_slang",
        "//libs/slang_utils:extensions_slang",
    ],
)

# Compile the GSplat strategy slang source into a SlangTorch C++ CUDA extension.
# Kept for test-only equivalence verification against the hand-written CUDA replacement.
# The main pylib no longer depends on this target.
slangtorch_library(
    name = "gsplat_strategy_slang_cc",
    srcs = [
        "strategy/gsplat.slang",
    ],
    extra_cmd_args = (
        "-I$$(dirname $$(dirname $(location //libs/slang_utils:extensions_slang))) "
    ),
    deps = COMMON_SLANG_FILES + [
        "//libs/slang_utils:extensions_slang",
    ],
)

# Hand-written CUDA replacement for the GSplat strategy Slang kernel
cuda_library(
    name = "gsplat_strategy_cuda",
    srcs = [
        "strategy/gsplat_cuda.cu",
    ],
    hdrs = [
        "strategy/gsplat_cuda.h",
    ],
    copts = [
        # Flags to be consistent with torch-cuda-extensions
        "-D__CUDA_NO_HALF_OPERATORS__",
        "-D__CUDA_NO_HALF_CONVERSIONS__",
        "-D__CUDA_NO_BFLOAT16_CONVERSIONS__",
        "-D__CUDA_NO_HALF2_OPERATORS__",
    ],
    deps = [
        "//libs/kernel_utils:ku_cc",
        "//libs/kernel_utils:ku_cuda",
        "@nre_pip_deps//torch:torch_headers",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)

cc_binary(
    name = "gsplat_strategy_cuda_cc",
    srcs = ["strategy/gsplat_cuda_binding.cpp"],
    copts = [
        # Flags to be consistent with torch-cuda-extensions and to build correct torch-extension bindings
        "-DTORCH_API_INCLUDE_EXTENSION_H",
        "-DTORCH_EXTENSION_NAME=libgsplat_strategy_cuda_cc",
    ],
    linkopts = [
        "-Wl,--no-undefined",
        "-Wl,--as-needed",
    ],
    linkshared = True,
    deps = [
        ":gsplat_strategy_cuda",
        "//libs/kernel_utils:ku_cc",
        "@nre_pip_deps//torch:libc10",
        "@nre_pip_deps//torch:libc10_cuda",
        "@nre_pip_deps//torch:libtorch_cpu",
        "@nre_pip_deps//torch:libtorch_python",
        "@nre_pip_deps//torch:torch_headers",
        "@rules_python//python/cc:current_py_cc_libs",
    ],
)

filegroup(
    name = "collector_slang_files",
    srcs = [
        "collector-default-configs.json",
        "collector/collector.slang-module",
    ],
)

py_library(
    name = "pylib",
    srcs = [
        "__init__.py",
        "collector/__init__.py",
        "collector/collector.py",
        "interface.py",
        "mcmc/__init__.py",
        "mcmc/mcmc.py",
        "strategy/__init__.py",
        "strategy/gsplat.py",
    ],
    data = [
        ":collector_slang_files",
        "//libs/slang_utils:ninja_runtime",
    ],
    deps = [
        ":collector_slang_cc",
        ":gsplat_strategy_cuda_cc",
        ":mcmc_slang_cc",
        ":pylib_codegen",
        "//libs/slang_utils:pylib_utils",
        "//nre/utils:pylib",
        pip_requirement("slangtorch"),
        pip_requirement("torch"),
    ],
)

pytest_test(
    name = "ray_intersect_test",
    srcs = [
        "common/ray_intersect_test.py",
    ],
    data = [
        "common/ray_intersect.slang",
        "common/search.slang",
        "//libs/geometry/kernels:slang_files",
        "//libs/slang_utils:constants_slang",
        "//libs/slang_utils:extensions_slang",
    ],
    deps = [
        ":pylib",
        "//libs/slang_utils:pylib_utils",
    ],
)

pytest_test(
    name = "search_test",
    srcs = [
        "common/search_test.py",
    ],
    data = [
        "common/search.slang",
        "common/search_test.slang",
        ":search_test_slang_module",
    ],
    deps = [
        ":pylib",
    ],
)

pytest_test(
    name = "collector_test",
    srcs = ["collector/collector_test.py"],
    deps = [
        ":pylib",
    ],
)

pytest_test(
    name = "gsplat_test",
    srcs = ["strategy/gsplat_test.py"],
    deps = [
        ":gsplat_strategy_slang_cc",
        ":pylib",
        "//nre/utils:pylib",
    ],
)

## Tracy profiler

# CUPTI library for GPU profiling
# Uses CUPTI_PATH environment variable if set, otherwise defaults to /usr/local/cuda/extras/CUPTI
cupti = use_repo_rule("//bazel/cuda:cupti.bzl", "cupti")

cupti(name = "cupti")

# Tracy default variant (CPU-only, no GPU profiling, no CUPTI dependency)
http_archive(
    name = "tracy",
    build_file_content = """
cc_library(
    name = 'tracy',
    srcs = ['public/TracyClient.cpp'],
    hdrs = glob([
        'public/tracy/*.h',
        'public/tracy/*.hpp',
        'public/common/*.h',
        'public/common/*.hpp',
        'public/client/*.h',
        'public/client/*.hpp',
        'public/libbacktrace/*.h',
        'public/libbacktrace/*.hpp',
    ]),
    textual_hdrs = glob([
        'public/common/*.cpp',
        'public/client/*.cpp',
        'public/libbacktrace/*.cpp',
    ]),  # These are included by TracyClient.cpp
    includes = ['public'],
    defines = [
        'TRACY_ENABLE',
        'TRACY_NO_GPU=1',  # Explicitly disable GPU features
        # Note: No TRACY_HAS_GPU for CPU-only build
    ],
    copts = [
        '-include', 'cstring',  # Workaround for missing include in Tracy 0.12.2
        '-Wno-unused-variable',  # Suppress unused variable warnings in Tracy 0.12.2
        '-Wno-unused-result',    # Suppress unused result warnings in Tracy 0.12.2
        '-Wno-unused-function',  # Suppress unused function warnings in Tracy 0.12.2
    ],
    linkopts = [
        '-lpthread',
        '-ldl',
    ],
    visibility = ['//visibility:public'],
    alwayslink = True,  # Force all symbols to be linked
    # Note: No CUPTI dependency for CPU-only build
)

cc_library(
    name = 'tracy_headers',
    hdrs = glob([
        'public/tracy/*.h',
        'public/tracy/*.hpp',
        'public/common/*.h',
        'public/common/*.hpp',
        'public/client/*.h',
        'public/client/*.hpp',
        'public/libbacktrace/*.h',
        'public/libbacktrace/*.hpp',
    ]),
    includes = ['public'],
    visibility = ['//visibility:public'],
)
""",
    sha256 = "09617765ba5ff1aa6da128d9ba3c608166c5ef05ac28e2bb77f791269d444952",
    strip_prefix = "tracy-0.12.2",
    urls = ["https://github.com/wolfpld/tracy/archive/refs/tags/v0.12.2.tar.gz"],
)


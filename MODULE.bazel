pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.whl_mods(
    additive_build_content = """
# Make torch headers / libraries available to C++ rules

cc_library(
    name = 'torch_headers',
    includes = [
        'site-packages/torch/include',
        'site-packages/torch/include/torch/csrc/api/include',
    ],
    hdrs = glob(['site-packages/torch/include/**/*.h']) + glob(['site-packages/torch/include/**/*.cuh']),
)

# ------------------------

cc_import(
    name = "libtorch_python",
    shared_library = "site-packages/torch/lib/libtorch_python.so",
)

# ------------------------

cc_import(
    name = "libc10",
    shared_library = "site-packages/torch/lib/libc10.so",
)

# ------------------------

cc_import(
    name = "libc10_cuda",
    shared_library = "site-packages/torch/lib/libc10_cuda.so",
)

# ------------------------

cc_import(
    name = "libtorch",
    shared_library = "site-packages/torch/lib/libtorch.so",
)

# ------------------------

cc_import(
    name = "libtorch_cpu",
    shared_library = "site-packages/torch/lib/libtorch_cpu.so",
)

# ------------------------

cc_import(
    name = "libtorch_cuda",
    shared_library = "site-packages/torch/lib/libtorch_cuda.so",
)
""",
    hub_name = "whl_mods_hub",
    whl_name = "torch",
)
pip.whl_mods(
    additive_build_content = """
# Make tcnn headers / libraries available to C++ rules

cc_library(
    name = 'tinycudann_headers',
    includes = [
        'site-packages/tinycudann/rtc/include'
    ],
    hdrs = glob(['site-packages/tinycudann/rtc/include/**/*']),
)

# ------------------------
""" +
                             "\n".join(["""
cc_import(
    name = "lib_tinycudann_{0}_{1}",
    shared_library = "site-packages/tinycudann_bindings/_{0}_C.cpython-311-{1}-linux-gnu.so",
)""".format(GPU_ARCH, CPU_ARCH) for GPU_ARCH in [
                                 70,
                                 75,
                                 80,
                                 86,
                                 89,
                                 90,
                                 100,
                                 120,
                             ] for CPU_ARCH in [
                                 "x86_64",
                                 "aarch64",
                             ]]),
    hub_name = "whl_mods_hub",
    whl_name = "tinycudann",
)
pip.whl_mods(
    additive_build_content = """
# Make numpy headers available to C++ rules

cc_library(
    name = 'numpy_headers',
    includes = [
        'site-packages/numpy/core/include',
    ],
    hdrs = glob(['site-packages/numpy/core/include/**/*.h']),
)
""",
    hub_name = "whl_mods_hub",
    whl_name = "numpy",
)

